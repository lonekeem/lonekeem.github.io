{
  "name": "Kemy by Lone Keem Studios",
  "short_name": "Kemy",
  "description": "Kemy by Lone Keem Studios: free, no ads. Virtual Kemy Pals, 3D Pal Park, zombie game, chess, pool, trivia and Lone Keem Studios Originals videos.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#8a2be2",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "video/mp4",
            "video/quicktime",
            "video/webm",
            ".mp4",
            ".mov",
            ".webm"
          ]
        }
      ]
    }
  }
}
