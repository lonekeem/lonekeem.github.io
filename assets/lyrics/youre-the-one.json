{"bpm":95.7,"instrumental":false,"lines":[
{"t": 0, "e": 5.35, "line": "No one does it like you do"},
{"t": 5.8, "e": 8.95, "line": "Knowing every part of me"},
{"t": 10.42, "e": 14.11, "line": "No one loves me like you do"},
{"t": 15.38, "e": 18.5, "line": "You see what no one else can see"},
{"t": 20.08, "e": 23.71, "line": "You came along and lit my soul"},
{"t": 24.9, "e": 28.42, "line": "When I was lost and coming undone"},
{"t": 29.43, "e": 33.52, "line": "I never thought I'd feel this whole"},
{"t": 33.47, "e": 38.79, "line": "But somehow, girl, you're the one"},
{"t": 40.19, "e": 45.34, "line": "The moment that I saw you, it's like I came to my senses"},
{"t": 45.29, "e": 50.05, "line": "I found the missing piece I'd been searching for"},
{"t": 50.0, "e": 52.87, "line": "You tore down all my fences"},
{"t": 52.96, "e": 58.36, "line": "You're the calm after every storm I've been through"},
{"t": 58.31, "e": 63.23, "line": "No one does it like you do"},
{"t": 64.4, "e": 67.81, "line": "You're the reason I believe"},
{"t": 67.76, "e": 72.83, "line": "In something strong and something true"},
{"t": 72.78, "e": 77.75, "line": "I was broke and couldn't breathe"},
{"t": 77.7, "e": 84.38, "line": "Then I found my way to you"},
{"t": 84.33, "e": 88.51, "line": "Every laugh, every tear we share"},
{"t": 88.46, "e": 94.3, "line": "Feels like home in your arms tonight"},
{"t": 94.52, "e": 98.08, "line": "And even when the road gets hard"},
{"t": 99.79, "e": 102.39, "line": "You're my morning light"},
