{"bpm":136.0,"instrumental":false,"lines":[
{"t": 2.3, "e": 7.48, "line": "Oh, oh, oh, Lone Keem Studios!"},
{"t": 7.48, "e": 9.24, "line": "Here we go! Here we go!"},
{"t": 13.7, "e": 17.22, "line": "Wake up, tap the screen, the For You feed is glowing"},
{"t": 17.48, "e": 20.72, "line": "Funny little videos, feel-good vibes keep on flowing"},
{"t": 20.9, "e": 24.06, "line": "Lone Keem Originals, I'm laughing on the floor"},
{"t": 24.09, "e": 27.86, "line": "Swipe up one more time, then I'm heading out the door"},
{"t": 28.0, "e": 33.28, "line": "Grab my pad, grab my keys"},
{"t": 34.5, "e": 41.4, "line": "Hop in the car, ride with me"},
{"t": 41.4, "e": 44.76, "line": "Welcome to Kemy, come on and stay"},
{"t": 45.03, "e": 48.35, "line": "Pals in the park and we're ready to play"},
{"t": 48.35, "e": 51.76, "line": "Stars in my pocket, diamonds that shine"},
{"t": 51.99, "e": 55.3, "line": "Made by Lone Keem, but the fun is all mine"},
