rules_version = '2';
// Lone Keem Studios - Firestore security rules.
// Admin = the verified Google/email account lillykemoy1@gmail.com.
// The studio account has the fixed id "studio" and is managed by the admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'lillykemoy1@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Unlimited Star Coins + Diamonds: the admin, or a player the admin gave an ∞ Pass (infPass/{uid}).
    // Only for your own wallet (callers already require uid == me()). One lookup, only reached for paid-0 buys.
    function unlimitedFor(uid) {
      return isAdmin() || (signedIn() && uid == me() && exists(/databases/$(database)/documents/infPass/$(uid))
        && get(/databases/$(database)/documents/infPass/$(uid)).data.unlimitedPass == true);
    }
    // Acting as yourself, or the admin acting as the studio account.
    function actingAs(uid) { return signedIn() && (uid == me() || (uid == 'studio' && isAdmin())); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Modded-keyboard tricks: zero-width / bidi / invisible fillers, or zalgo (3+ stacked combining marks). ZWJ (U+200D) stays for emoji.
    function cleanStr(v, min, max) { return isStr(v, min, max) && !v.matches('(?s).*([\\x{200B}\\x{200C}\\x{200E}\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}\\x{3164}\\x{115F}\\x{1160}\\x{FFA0}\\x{00AD}]|[\\x{0300}-\\x{036F}]{3,}).*'); }
    function blockedBy(owner) { return exists(/databases/$(database)/documents/users/$(owner)/blocks/$(me())); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // "Sign out everywhere" (js/devices.js): sessions that signed in before users/{uid}.sessionsValidAfter are refused
    // here (auth_time is whole seconds, hence the +1 s). Checked on profile, device and security writes.
    function sessionOk(uid) {
      let d = get(/databases/$(database)/documents/users/$(uid)).data;
      return !('sessionsValidAfter' in d) || (request.auth.token.auth_time + 1) * 1000 > d.sessionsValidAfter.toMillis();
    }
    // ---------- Moderators + bans ----------
    // roles/{uid} {mod: true} is written only by the admin. bans/{uid} {until, ...} by moderators.
    function rolePath(u) { return /databases/$(database)/documents/roles/$(u); }
    function banPath(u) { return /databases/$(database)/documents/bans/$(u); }
    // Watchlist (warned / suspended / restricted by a moderator): their pictures and videos must go
    // through heldPosts first, and stories are paused. A ban doc (even an expired one) also counts.
    function watchPath(u) { return /databases/$(database)/documents/watchlist/$(u); }
    function watched(u) {
      return u != 'studio' && !isAdmin()
        && (exists(banPath(u)) || (exists(watchPath(u)) && get(watchPath(u)).data.until > request.time));
    }
    function hasMedia(d) { return d.get('mediaUrl', '') != '' || d.get('work', {}).get('cover', '') != ''; }
    // The AI helper moderator ('Kemy Helper'): a moderator whose role has ai == true (admin-set).
    function isAI() { return signedIn() && exists(rolePath(me())) && get(rolePath(me())).data.get('ai', false) == true; }
    function isMod() { return isAdmin() || (signedIn() && exists(rolePath(me())) && get(rolePath(me())).data.mod == true); }
    // Banned right now (the admin can never be locked out).
    // ---------- Kid & teen safety (js/safety.js) ----------
    // Birthday (birthY/birthM, self-declared, set once; only the admin or a human moderator can
    // change it), Community Rules agreement (rulesAt), and a mod-controlled under-13 flag
    // (underage/{uid}) that the user can't touch. Posting, uploads, comments and DMs need all three.
    function u13Path(u) { return /databases/$(database)/documents/underage/$(u); }
    function ageOkData(d) {
      let y = d.get('birthY', 0);
      return y is int && (request.time.year() - y) * 12 + (request.time.month() - d.get('birthM', 12)) >= 156;
    }
    function canCreate(u) {
      let d = get(userPath(u)).data;
      return isAdmin() || u == 'studio' || (ageOkData(d) && d.get('rulesAt', null) is timestamp && !exists(u13Path(u)));
    }
    // Parental Controls (js/parental.js): users/{uid}.pc flags. Read from the already-fetched profile
    // doc so these checks add no extra lookups. pcOff(d, k): that feature was switched off by a parent.
    function validPc(m) {
      return m is map && m.keys().hasOnly(['chat', 'dm', 'live', 'cmt', 'buy', 'time', 'vis', 'safe'])
        && m.get('chat', true) is bool && m.get('live', true) is bool && m.get('cmt', true) is bool && m.get('safe', true) is bool
        && m.get('dm', 'friends') in ['off', 'friends', 'everyone'] && m.get('buy', 'pin') in ['block', 'pin', 'open']
        && m.get('time', 0) in [0, 30, 60, 120] && m.get('vis', 'public') in ['private', 'friends', 'public'];
    }
    function pcOff(d, k) { return d.get('pc', {}).get(k, true) == false; }
    function pcNoDm(d) { return d.get('pc', {}).get('dm', 'friends') == 'off'; }
    function validBirth(d) {
      return !('birthY' in d) || (d.birthY is int && d.get('birthM', 0) is int && d.birthY >= 1900 && d.birthY <= 2100 && d.birthM >= 1 && d.birthM <= 12);
    }
    function notBanned() { return !signedIn() || isAdmin() || !exists(banPath(me())) || get(banPath(me())).data.until <= request.time; }

    // ---------- Usernames (uniqueness) ----------
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && actingAs(request.resource.data.uid)
        && getAfter(userPath(request.resource.data.uid)).data.username == name;
      allow delete: if isAdmin() || (signedIn() && actingAs(resource.data.uid)
        && (!existsAfter(userPath(resource.data.uid))
            || getAfter(userPath(resource.data.uid)).data.username != name));
    }

    // ---------- Profiles ----------
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'username', 'bio', 'color', 'createdAt', 'welcomed',
                               'lastPostAt', 'lastCommentAt', 'lastMessageAt', 'isStudio',
                               'usernameLower', 'displayNameLower', 'photoURL', 'storyUntil',
                               'pronouns', 'website', 'activePet', 'birthY', 'birthM', 'rulesAt',
                               'postDay', 'postsToday', 'lastFollowAt', 'lastNewChatAt', 'sessionsValidAfter', 'pc'])
        && (!('pc' in d) || validPc(d.pc))
        && validBirth(d)
        && validUserSearch(d)
        && d.keys().hasAll(['displayName', 'username', 'bio', 'color', 'createdAt', 'welcomed'])
        && cleanStr(d.displayName, 1, 50)
        && d.username is string && d.username.matches('^[a-z0-9_.]{3,20}$')
        && cleanStr(d.bio, 0, 160)
        && (!('pronouns' in d) || isStr(d.pronouns, 0, 20))
        && (!('website' in d) || d.website == ''
            || (isStr(d.website, 12, 100) && d.website.matches('https://[A-Za-z0-9-]+([.][A-Za-z0-9-]+)+(:[0-9]+)?(/[^\\s\"<>]*)?')))
        && isStr(d.color, 1, 20)
        && (!('activePet' in d) || (d.activePet is string && d.activePet.matches('^(p[1-6])?$')))
        && d.welcomed is bool
        && d.createdAt is timestamp;
    }
    // Search fields (lowercase copies used for prefix search). Optional for older profiles.
    function validUserSearch(d) {
      return (!('usernameLower' in d) || d.usernameLower == d.username)
        && (!('displayNameLower' in d) || isStr(d.displayNameLower, 0, 100));
    }
    // Rate limit: a "last action" timestamp may only be set to now, and only after `secs` seconds.
    function rateOk(field, secs) {
      return !(field in changed())
        || (request.resource.data[field] == request.time
            && (isAdmin() || !(field in resource.data)
                || resource.data[field] + duration.value(secs, 's') < request.time));
    }

    // ---------- Anti-spam (js/spam.js does the friendly client-side checks) ----------
    function isNewAcct(d) { return d.get('createdAt', request.time) > request.time - duration.value(3, 'd'); }
    // Links in free text (our own Cloudinary media links don't count).
    function linkText(t) { return t.replace('https://res[.]cloudinary[.]com/[^\\s]*', ''); }
    function hasLink(t) { return linkText(t).matches('(?is).*(https?://|www[.]).*'); }
    function tooManyLinks(t) { return linkText(t).matches('(?is)(.*(https?://|www[.])){3,}.*'); }
    // New accounts: no links; everyone else: at most 2 links per post / comment / message.
    function linksOk(t, u) { return !tooManyLinks(t) && (!isNewAcct(u) || !hasLink(t)); }
    function dayNo() { return math.floor(request.time.toMillis() / 86400000); }
    // Daily post cap: accounts under 3 days old get 5 posts (and lives / stories) per UTC day.
    // postDay / postsToday only change together with lastPostAt.
    function postCapOk() {
      let n = request.resource.data;
      let o = resource.data;
      return (!changed().hasAny(['postDay', 'postsToday']) || 'lastPostAt' in changed())
        && (!('lastPostAt' in changed()) || isAdmin()
          || (!isNewAcct(o) && (!('postDay' in n) || (n.postDay is int && n.get('postsToday', 0) is int)))
          || (n.get('postDay', null) is int && n.postDay >= dayNo() - 1 && n.postDay <= dayNo()
              && n.postDay >= o.get('postDay', 0)
              && n.get('postsToday', 0) == (n.postDay == o.get('postDay', -1) ? o.get('postsToday', 0) + 1 : 1)
              && n.postsToday <= 5));
    }

    // Private feed interests (For You ranking), readable / writable only by the owner.
    match /users/{uid}/prefs/{docId} {
      function scoreMap(m, n) { return m is map && m.size() <= n; }
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me() && docId == 'feed'
        && request.resource.data.keys().hasOnly(['cats', 'creators', 'updatedAt'])
        && scoreMap(request.resource.data.cats, 20) && scoreMap(request.resource.data.creators, 60)
        && request.resource.data.updatedAt == request.time;
      // Optional push switches (js/push.js). Owner only. Missing types stay on once they opt in.
      allow create, update: if signedIn() && uid == me() && docId == 'push' && sessionOk(uid)
        && request.resource.data.keys().hasOnly(['enabled', 'invite', 'turn', 'house', 'daily', 'announce', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.invite is bool && request.resource.data.turn is bool
        && request.resource.data.house is bool && request.resource.data.daily is bool
        && request.resource.data.announce is bool
        && request.resource.data.updatedAt == request.time;
      // Which What's New entry this player has opened (js/updates.js). Owner only.
      allow create, update: if signedIn() && uid == me() && docId == 'updates' && sessionOk(uid)
        && request.resource.data.keys().hasOnly(['seen', 'updatedAt'])
        && isStr(request.resource.data.seen, 1, 40)
        && request.resource.data.updatedAt == request.time;
      // Private search history (Search > Recent), max 20 short strings. Deleted by "Clear all" and with the account.
      allow create, update: if signedIn() && uid == me() && docId == 'security'
        && request.resource.data.keys().hasOnly(['alerts', 'updatedAt']) && request.resource.data.alerts is bool
        && request.resource.data.updatedAt == request.time && sessionOk(uid);
      allow create, update: if signedIn() && uid == me() && docId == 'search'
        && request.resource.data.keys().hasOnly(['recent', 'updatedAt'])
        && request.resource.data.recent is list && request.resource.data.recent.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // What's New entries (js/updates.js). Everyone can read. Only the verified admin can write.
    // updates.json in the repo is the fallback; a doc with the same id replaces that entry.
    match /updates/{id} {
      function validUpdate(d) {
        return d.keys().hasOnly(['date', 'title', 'body', 'emoji', 'image', 'link', 'createdAt'])
          && d.keys().hasAll(['date', 'title', 'body', 'createdAt'])
          && d.date is string && d.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && cleanStr(d.title, 1, 80) && cleanStr(d.body, 1, 400)
          && d.createdAt is timestamp
          && (!('emoji' in d) || isStr(d.emoji, 1, 16))
          && (!('image' in d) || (isStr(d.image, 1, 120) && d.image.matches('^[A-Za-z0-9_./-]+$') && !d.image.matches('.*\\.\\..*')))
          && (!('link' in d) || (isStr(d.link, 2, 80) && (d.link.matches('^#/[A-Za-z0-9_./?=&%-]{1,78}$') || d.link.matches('^[a-z0-9][A-Za-z0-9./_-]{0,78}$'))));
      }
      allow read: if true;
      allow create: if isAdmin() && id.matches('^[a-z0-9-]{3,40}$') && validUpdate(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && id.matches('^[a-z0-9-]{3,40}$') && validUpdate(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Trending searches: searchTrends/{day}_{slug} = { day, q, n }. Anyone can read; signed-in users create a
    // doc with n == 1 or add exactly 1. The app only counts kid-safe queries, once per user per query per day.
    match /searchTrends/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['day', 'q', 'n'])
        && request.resource.data.n == 1 && request.resource.data.q is string
        && request.resource.data.q.matches('^[a-z0-9# ]{2,30}$')
        && request.resource.data.day is string && request.resource.data.day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && id == request.resource.data.day + '_' + request.resource.data.q.replace('#', '~').replace(' ', '-');
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && uid == me()
        && validProfile(request.resource.data)
        && !request.resource.data.keys().hasAny(['isStudio', 'lastPostAt', 'lastCommentAt', 'lastMessageAt', 'photoURL', 'storyUntil', 'rulesAt', 'postDay', 'postsToday', 'lastFollowAt', 'lastNewChatAt', 'sessionsValidAfter'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if actingAs(uid)
        && (uid != me() || !('sessionsValidAfter' in resource.data) || (request.auth.token.auth_time + 1) * 1000 > resource.data.sessionsValidAfter.toMillis())
        && (!('sessionsValidAfter' in changed()) || (uid == me() && request.resource.data.sessionsValidAfter == request.time))
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('isStudio', false) == resource.data.get('isStudio', false)
        && (request.resource.data.username == resource.data.username
            || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid)
        && rateOk('lastPostAt', 20)
        && rateOk('lastCommentAt', 5)
        && rateOk('lastMessageAt', 1)
        // Anti-spam: follows at most one per 2 s, new DM conversations one per 8 s, daily post cap for new accounts.
        && rateOk('lastFollowAt', 2)
        && rateOk('lastNewChatAt', 8)
        && postCapOk()
        // Birthday: set once, then locked (admin / human moderators fix mistakes below).
        && (!('birthY' in resource.data) || (request.resource.data.get('birthY', 0) == resource.data.birthY && request.resource.data.get('birthM', 0) == resource.data.birthM))
        // Rules agreement: set to now, once.
        && (!('rulesAt' in changed()) || (!('rulesAt' in resource.data) && request.resource.data.rulesAt == request.time))
        // Profile photo: '' (removed) or an image on our Cloudinary cloud (blocked until the
        // real cloud name is set, same placeholder as media posts). Checked only when it changes.
        && (!('photoURL' in changed()) || request.resource.data.photoURL == ''
            || cloudinaryImageUrl(request.resource.data.photoURL))
        // "Has a live story until" hint, written together with a new story.
        && (!('storyUntil' in changed()) || (request.resource.data.storyUntil is timestamp
            && request.resource.data.storyUntil > request.time
            && request.resource.data.storyUntil <= request.time + duration.value(24, 'h')));
      // Admin or a human moderator corrects a birthday.
      allow update: if isMod() && !isAI() && changed().hasOnly(['birthY', 'birthM']) && validBirth(request.resource.data)
        && 'birthY' in request.resource.data;
      // Admin search-index rebuild: only the search fields, on any profile.
      allow update: if isAdmin()
        && changed().hasOnly(['usernameLower', 'displayNameLower'])
        && validUserSearch(request.resource.data);
      // Account deletion: you can delete your own profile (the studio account and the admin's own
      // account can't be deleted this way); the admin can remove other accounts.
      allow delete: if uid != 'studio'
        && ((signedIn() && uid == me() && !isAdmin()) || (isAdmin() && uid != me()));

      // Private favourites
      match /saved/{postId} {
        allow read, delete: if signedIn() && uid == me();
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['postId', 'createdAt'])
          && request.resource.data.postId == postId
          && request.resource.data.createdAt == request.time;
      }

      // Private block list (rules can still check it with exists())
      match /blocks/{other} {
        allow read, delete: if actingAs(uid);
        allow create: if actingAs(uid) && other != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // New-device sign-in devices: owner only (rough UA label + timestamps, no IP / location).
      match /devices/{dev} {
        function validDev(d) {
          return d.keys().hasOnly(['label', 'firstSeen', 'lastSeen', 'ack']) && isStr(d.label, 1, 60) && d.ack is bool
            && d.firstSeen is timestamp && d.lastSeen is timestamp;
        }
        allow read, delete: if signedIn() && uid == me();
        allow create: if signedIn() && uid == me() && dev.matches('^[A-Za-z0-9]{16,40}$') && exists(userPath(uid)) && sessionOk(uid)
          && validDev(request.resource.data)
          && request.resource.data.firstSeen == request.time && request.resource.data.lastSeen == request.time;
        allow update: if signedIn() && uid == me() && sessionOk(uid) && validDev(request.resource.data)
          && request.resource.data.firstSeen == resource.data.firstSeen
          && (!('lastSeen' in changed()) || request.resource.data.lastSeen == request.time)
          && (!('ack' in changed()) || request.resource.data.ack == true);
      }

      // FCM web push tokens. The id is this browser's device id. Only the owner can read or write it.
      match /fcmTokens/{id} {
        function validToken(d) {
          return d.keys().hasOnly(['token', 'label', 'tz', 'tzOffset', 'local', 'updatedAt'])
            && isStr(d.token, 10, 4096) && isStr(d.label, 1, 60) && isStr(d.tz, 0, 80)
            && d.tzOffset is int && d.tzOffset >= -840 && d.tzOffset <= 840
            && d.local is bool && d.updatedAt == request.time;
        }
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if signedIn() && uid == me() && exists(userPath(uid)) && sessionOk(uid)
          && id.matches('^[A-Za-z0-9]{16,40}$') && validToken(request.resource.data);
      }
      // Daily send count. Cloud Functions (Admin SDK) write it. The owner may only read or delete it.
      match /pushQuota/{qid} {
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if false;
      }

      match /notifications/{nid} {
        allow read, delete: if actingAs(uid);
        // "Kemy Security" new-device alert, written by the owner's own new device to their own inbox.
        allow create: if signedIn() && uid == me() && sessionOk(uid)
          && request.resource.data.keys().hasOnly(['type', 'fromUid', 'fromName', 'fromUsername', 'postId', 'text', 'createdAt', 'read'])
          && request.resource.data.type == 'security' && request.resource.data.fromUid == me()
          && request.resource.data.fromName == 'Kemy Security' && request.resource.data.fromUsername == ''
          && isStr(request.resource.data.postId, 0, 40) && isStr(request.resource.data.text, 1, 200)
          && request.resource.data.text.matches('^New sign-in on .*')
          && request.resource.data.createdAt == request.time && request.resource.data.read == false;
        // The invited user tells the admin who invited them how they answered.
        allow create: if signedIn() && request.resource.data.type == 'mod_invite' && request.resource.data.fromUid == me()
          && request.resource.data.keys().hasOnly(['type', 'fromUid', 'fromName', 'fromUsername', 'postId', 'text', 'createdAt', 'read'])
          && exists(/databases/$(database)/documents/modInvites/$(me()))
          && get(/databases/$(database)/documents/modInvites/$(me())).data.by == uid
          && request.resource.data.fromName == get(userPath(me())).data.displayName
          && request.resource.data.fromUsername == get(userPath(me())).data.username
          && request.resource.data.postId == '' && cleanStr(request.resource.data.text, 0, 140)
          && request.resource.data.createdAt == request.time && request.resource.data.read == false;
        // Moderator notices ("Thanks, we took action" / warnings / suspensions), shown as "Kemy Moderators".
        allow create: if isMod() && exists(userPath(uid))
          && request.resource.data.keys().hasOnly(['type', 'fromUid', 'fromName', 'fromUsername', 'postId', 'text', 'createdAt', 'read'])
          && request.resource.data.type == 'mod' && request.resource.data.fromUid == me()
          && request.resource.data.fromName == 'Kemy Moderators' && request.resource.data.fromUsername == ''
          && isStr(request.resource.data.postId, 0, 100) && cleanStr(request.resource.data.text, 1, 400)
          && request.resource.data.createdAt == request.time && request.resource.data.read == false;
        allow update: if actingAs(uid)
          && changed().hasOnly(['read']) && request.resource.data.read is bool;
        allow create: if signedIn() && !isBlocked(uid, request.resource.data.fromUid)
          && exists(userPath(uid))
          && request.resource.data.keys().hasOnly(['type', 'fromUid', 'fromName', 'fromUsername', 'postId', 'text', 'createdAt', 'read'])
          && request.resource.data.type in ['follow', 'like', 'comment', 'message', 'reply', 'comment_like', 'game', 'pal_pat', 'pal_play', 'episode', 'house']
          && actingAs(request.resource.data.fromUid)
          && request.resource.data.fromUid != uid
          && request.resource.data.fromName == get(userPath(request.resource.data.fromUid)).data.displayName
          && request.resource.data.fromUsername == get(userPath(request.resource.data.fromUid)).data.username
          && isStr(request.resource.data.postId, 0, 100)
          && cleanStr(request.resource.data.text, 0, 140)
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false;
      }
    }

    // ---------- Posts ----------
    // Cloudinary cloud name for photo/video posts. PLACEHOLDER until the real account exists:
    // this is the ONLY line to change (scripts/set-cloud-name.sh <cloud_name> updates it and
    // js/media-config.js together). Media URLs must start with https://res.cloudinary.com/<cloud>/.
    function cloudinaryCloud() { return 'zfmeldgm'; }
    function cloudinaryImageUrl(u) {
      return u is string && u.size() <= 500
        && u.matches('^https://res[.]cloudinary[.]com/' + cloudinaryCloud() + '/image/upload/[^?#]+$');
    }
    function cloudinaryUrl(u) {
      return u is string && u.size() <= 500
        && u.matches('^https://res[.]cloudinary[.]com/' + cloudinaryCloud() + '/(image|video)/upload/[^?#]+$');
    }
    // Extra fields on camera / library posts (all-or-nothing).
    function validMediaExtras(d) {
      return !d.keys().hasAny(['posterUrl', 'width', 'height', 'duration', 'cloudinaryPublicId'])
        || (d.keys().hasAll(['posterUrl', 'width', 'height', 'duration', 'cloudinaryPublicId'])
            && d.type == 'media'
            && d.mediaType in ['image', 'video']
            && cloudinaryUrl(d.mediaUrl)
            && cloudinaryUrl(d.posterUrl)
            && d.poster == d.posterUrl
            && d.width is int && d.width >= 0 && d.width <= 20000
            && d.height is int && d.height >= 0 && d.height <= 20000
            && d.duration is number && d.duration >= 0 && d.duration <= 601
            && (d.mediaType == 'video' || d.duration == 0)
            && isStr(d.cloudinaryPublicId, 1, 255)
            && d.cloudinaryPublicId.matches('^[A-Za-z0-9_./-]+$'));
    }
    // Search fields on posts: lowercase keywords (words + prefixes) and #hashtags, size-capped.
    function validPostSearch(d) {
      return (!('keywords' in d) || (d.keywords is list && d.keywords.size() <= 100
                                     && d.keywords.join(' ').size() <= 2000))
        && (!('hashtags' in d) || (d.hashtags is list && d.hashtags.size() <= 20
                                   && d.hashtags.join(' ').size() <= 900));
    }
    // Feed categories (keep in sync with js/feed-cats.js).
    function postCats() {
      return ['funny', 'news', 'music', 'gaming', 'pals', 'art', 'sports', 'movies', 'animals', 'food', 'dance', 'learning', 'other'];
    }
    function validNewPost(d) {
      let u = get(userPath(d.authorId)).data;
      return d.keys().hasOnly(['authorId', 'authorName', 'authorUsername', 'authorColor', 'type', 'text',
                               'linkUrl', 'mediaUrl', 'mediaType', 'poster', 'createdAt', 'likeCount',
                               'commentCount', 'lastCommentId', 'studio',
                               'posterUrl', 'width', 'height', 'duration', 'cloudinaryPublicId',
                               'keywords', 'hashtags', 'work', 'cat'])
        && validPostSearch(d)
        && (!('cat' in d) || d.cat in postCats())
        && d.keys().hasAll(['authorId', 'authorName', 'authorUsername', 'authorColor', 'type', 'text',
                            'linkUrl', 'mediaUrl', 'mediaType', 'poster', 'createdAt', 'likeCount',
                            'commentCount', 'lastCommentId', 'studio'])
        && d.authorName == u.displayName
        && d.authorUsername == u.username
        && d.authorColor == u.color
        && d.type in ['text', 'link', 'media', 'movie', 'song']
        && ((d.type in ['movie', 'song']) == ('work' in d))
        && (!('work' in d) || validWork(d))
        && cleanStr(d.text, 0, 2000)
        && (d.authorId == 'studio' || isAdmin() || linksOk(d.text, u))
        && isStr(d.linkUrl, 0, 300)
        && isStr(d.mediaUrl, 0, 500)
        && (d.mediaType in ['', 'image', 'video'] || (d.mediaType == 'audio' && d.type == 'song'))
        && isStr(d.poster, 0, 500)
        && (d.linkUrl == '' || d.linkUrl.matches('^https://([a-z0-9-]+[.])*(youtube[.]com|youtu[.]be|tiktok[.]com)/.*$'))
        && (d.authorId == 'studio' || d.mediaUrl == '' || cloudinaryUrl(d.mediaUrl))
        && (d.authorId == 'studio' || d.poster == '' || cloudinaryUrl(d.poster))
        && (d.mediaUrl == '' || d.mediaType in ['image', 'video', 'audio'])
        && validMediaExtras(d)
        && (d.text.size() > 0 || d.linkUrl != '' || d.mediaUrl != '')
        && d.createdAt == request.time
        && d.likeCount == 0 && d.commentCount == 0 && d.lastCommentId == ''
        && d.studio == (d.authorId == 'studio')
        && getAfter(userPath(d.authorId)).data.lastPostAt == request.time;
    }

    // Community movies + songs (type 'movie' / 'song'): a validated `work` map; either a YouTube id
    // or an upload on our Cloudinary cloud. Creator must tick the rights box.
    function validWork(d) {
      let w = d.work;
      let movieG = ['Action', 'Comedy', 'Drama', 'Horror', 'Sci-Fi', 'Fantasy', 'Romance', 'Animation', 'Music', 'Documentary', 'Other'];
      let songG = ['Hip-Hop', 'R&B', 'Pop', 'Rock', 'Gospel', 'Afrobeats', 'Dancehall/Reggae', 'Electronic', 'Country', 'Lo-fi', 'Other'];
      return w is map
        && w.keys().hasOnly(['title', 'genre', 'rating', 'aiTools', 'runtime', 'yt', 'artist', 'lyrics', 'explicit', 'cover', 'rights'])
        && w.keys().hasAll(['title', 'genre', 'aiTools', 'runtime', 'yt', 'cover', 'rights'])
        && w.rights == true
        && isStr(w.title, 1, 80)
        && isStr(w.aiTools, 0, 100)
        && w.runtime is number && w.runtime >= 0 && w.runtime <= 86400
        && w.yt is string && (w.yt == '' || w.yt.matches('^[A-Za-z0-9_-]{11}$'))
        && (w.cover == '' || cloudinaryUrl(w.cover))
        && cleanStr(d.text, 0, 1000)
        && ((w.yt != '' && d.mediaUrl == '') || (w.yt == '' && cloudinaryUrl(d.mediaUrl) && (w.runtime <= 601)))
        && (d.type == 'movie'
              ? (w.genre in movieG && w.rating in ['all', '13', '16', '18'] && !w.keys().hasAny(['artist', 'lyrics', 'explicit'])
                 && (d.mediaUrl == '' || d.mediaType == 'video'))
              : (w.genre in songG && isStr(w.artist, 1, 50) && isStr(w.get('lyrics', ''), 0, 5000) && w.get('explicit', false) is bool
                 && !('rating' in w) && (d.mediaUrl == '' || d.mediaType == 'audio')));
    }

    match /posts/{postId} {
      // Videos from accounts under 3 days old go to heldPosts first (the app also holds accounts with
      // fewer than config/mediaReview.minApproved posts; rules can't count, so that part is app-side).
      function newVideoOk(d) {
        return d.get('mediaType', '') != 'video' || isAdmin() || d.authorId == 'studio'
          || get(userPath(d.authorId)).data.createdAt < request.time - duration.value(3, 'd');
      }
      function postPath() { return /databases/$(database)/documents/posts/$(postId); }
      function likeChange() {
        let likeP = /databases/$(database)/documents/posts/$(postId)/likes/$(me());
        let n = request.resource.data;
        let o = resource.data;
        return changed().hasOnly(['likeCount'])
          && ((n.likeCount == o.likeCount + 1 && !exists(likeP) && existsAfter(likeP))
              || (n.likeCount == o.likeCount - 1 && exists(likeP) && !existsAfter(likeP)));
      }
      function commentChange() {
        let n = request.resource.data;
        let o = resource.data;
        let cP = /databases/$(database)/documents/posts/$(postId)/comments/$(n.lastCommentId);
        return changed().hasOnly(['commentCount', 'lastCommentId'])
          && isStr(n.lastCommentId, 1, 100)
          && ((n.commentCount == o.commentCount + 1 && !exists(cP) && existsAfter(cP))
              || (n.commentCount == o.commentCount - 1 && exists(cP) && !existsAfter(cP))
              // "Comment deleted" (a comment with replies is blanked instead of removed)
              || (n.commentCount == o.commentCount - 1 && exists(cP) && existsAfter(cP)
                  && get(cP).data.get('deleted', false) == false && getAfter(cP).data.get('deleted', false) == true));
      }

      allow read: if true;
      allow create: if signedIn() && notBanned() && actingAs(request.resource.data.authorId) && validNewPost(request.resource.data) && canCreate(request.resource.data.authorId)
        && newVideoOk(request.resource.data)
        && !(hasMedia(request.resource.data) && watched(request.resource.data.authorId));
      // Moderator "Restore": an exact copy of the held post, moved out of heldPosts in the same batch.
      allow create: if isMod() && exists(/databases/$(database)/documents/heldPosts/$(postId))
        && request.resource.data == get(/databases/$(database)/documents/heldPosts/$(postId)).data.post
        && !existsAfter(/databases/$(database)/documents/heldPosts/$(postId));
      // Search-index backfill by the author (or admin): only keywords / hashtags.
      function searchChange() {
        return changed().hasOnly(['keywords', 'hashtags'])
          && (actingAs(resource.data.authorId) || isAdmin())
          && validPostSearch(request.resource.data);
      }
      // Views: exactly +1 on viewCount and nothing else. Signed-in viewers must create their own
      // views/{uid} doc in the same batch (so it counts once per account); signed-out visitors can
      // only add 1 at a time (once per device, enforced in the app).
      function viewDocAdded() {
        let viewP = /databases/$(database)/documents/posts/$(postId)/views/$(request.auth.uid);
        return !exists(viewP) && existsAfter(viewP);
      }
      function viewChange() {
        return changed().hasOnly(['viewCount'])
          && request.resource.data.viewCount is int
          && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
          && (!signedIn() || viewDocAdded());
      }
      // Studio Picks: only the admin can feature / unfeature a community movie or song.
      function featureChange() {
        return isAdmin() && changed().hasOnly(['featured']) && request.resource.data.featured is bool
          && resource.data.type in ['movie', 'song'];
      }
      // Category: the author (or admin) can set / change it later.
      function catChange() {
        return changed().hasOnly(['cat']) && (actingAs(resource.data.authorId) || isAdmin())
          && request.resource.data.cat in postCats();
      }
      // Shares: exactly +1, once per account (shares/{uid} created in the same batch).
      function shareChange() {
        let shareP = /databases/$(database)/documents/posts/$(postId)/shares/$(request.auth.uid);
        return changed().hasOnly(['shareCount'])
          && request.resource.data.shareCount is int
          && request.resource.data.shareCount == resource.data.get('shareCount', 0) + 1
          && !exists(shareP) && existsAfter(shareP);
      }
      // Reports: +1 per different person (flags/{uid} created in the same batch); 3+ => hidden in the
      // app until a moderator keeps it (reportOk = reportCount) or removes it.
      function reportChange() {
        let fP = /databases/$(database)/documents/posts/$(postId)/flags/$(request.auth.uid);
        return changed().hasOnly(['reportCount'])
          && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
          && resource.data.authorId != me() && !exists(fP) && existsAfter(fP);
      }
      function reportOkChange() {
        return isMod() && changed().hasOnly(['reportOk']) && request.resource.data.reportOk == resource.data.get('reportCount', 0);
      }
      allow update: if viewChange() || (signedIn() && (likeChange() || commentChange() || searchChange() || featureChange() || catChange() || shareChange() || reportChange() || reportOkChange()));
      allow delete: if signedIn() && (resource.data.authorId == me() || isMod());

      match /flags/{flaggerId} {
        allow read: if signedIn() && (flaggerId == me() || isMod());
        allow create: if signedIn() && flaggerId == me()
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && getAfter(postPath()).data.get('reportCount', 0) == get(postPath()).data.get('reportCount', 0) + 1;
        allow delete: if signedIn() && (isMod() || !existsAfter(postPath()));
      }

      match /likes/{likerId} {
        allow read: if true;
        allow create: if signedIn() && likerId == me()
          && request.resource.data.keys().hasOnly(['createdAt', 'uid'])
          && request.resource.data.get('uid', me()) == me()
          && request.resource.data.createdAt == request.time
          && getAfter(postPath()).data.likeCount == get(postPath()).data.likeCount + 1;
        allow delete: if signedIn() && likerId == me()
          && getAfter(postPath()).data.likeCount == get(postPath()).data.likeCount - 1;
        // Leftovers of a deleted post (deleted with it in the same batch, or afterwards).
        allow delete: if signedIn() && !existsAfter(postPath());
      }

      match /shares/{sharerId} {
        allow read: if signedIn() && sharerId == me();
        allow list: if signedIn() && actingAs(get(postPath()).data.authorId);
        allow create: if signedIn() && sharerId == me()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(postPath()).data.get('shareCount', 0) == get(postPath()).data.get('shareCount', 0) + 1;
        allow delete: if signedIn() && (sharerId == me() || !existsAfter(postPath()));
      }

      match /views/{viewerId} {
        allow read: if signedIn() && viewerId == me();
        // The author can list them only to clean up when deleting the post / their account.
        allow list: if signedIn() && actingAs(get(postPath()).data.authorId);
        allow delete: if signedIn() && !existsAfter(postPath());
        allow create: if signedIn() && viewerId == me()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(postPath()).data.get('viewCount', 0) == get(postPath()).data.get('viewCount', 0) + 1;
      }

      match /comments/{cid} {
        function cPath(id) { return /databases/$(database)/documents/posts/$(postId)/comments/$(id); }
        function me_() { return get(userPath(me())).data; }
        function canModerate() {
          return resource.data.authorId == me() || isMod() || actingAs(get(postPath()).data.authorId);
        }
        // A reply: one level deep, under a live (not deleted) top-level comment, which counts it.
        function validReplyTo(pid) {
          let par = get(cPath(pid)).data;
          let parAfter = getAfter(cPath(pid)).data;
          return pid is string && pid != cid && exists(cPath(pid))
            && !('parentId' in par) && par.get('deleted', false) == false
            && parAfter.get('replyCount', 0) == par.get('replyCount', 0) + 1
            && parAfter.lastReplyId == cid;
        }
        // Stars on a comment: exactly +/-1, tied to your own likes/{uid} doc.
        function cLikeChange() {
          let likeP = /databases/$(database)/documents/posts/$(postId)/comments/$(cid)/likes/$(me());
          let n = request.resource.data;
          let o = resource.data;
          return changed().hasOnly(['likeCount']) && n.likeCount is int
            && ((n.likeCount == o.get('likeCount', 0) + 1 && !exists(likeP) && existsAfter(likeP))
                || (n.likeCount == o.get('likeCount', 0) - 1 && exists(likeP) && !existsAfter(likeP)));
        }
        // Reply count on a top-level comment: +/-1, tied to the reply being added/removed.
        function replyChange() {
          let n = request.resource.data;
          let o = resource.data;
          let rP = cPath(n.lastReplyId);
          return changed().hasOnly(['replyCount', 'lastReplyId']) && isStr(n.lastReplyId, 1, 100)
            && !('parentId' in o)
            && ((n.replyCount == o.get('replyCount', 0) + 1 && !exists(rP) && existsAfter(rP)
                 && getAfter(rP).data.parentId == cid)
                || (n.replyCount == o.get('replyCount', 0) - 1 && exists(rP) && !existsAfter(rP)
                    && get(rP).data.parentId == cid));
        }
        // Deleting a comment that has replies leaves a blank "Comment deleted" placeholder.
        function softDelete() {
          let n = request.resource.data;
          return canModerate() && !('parentId' in resource.data)
            && resource.data.get('deleted', false) == false
            && changed().hasOnly(['deleted', 'text', 'authorName', 'authorUsername', 'authorColor', 'media'])
            && !('media' in n) && n.deleted == true && n.text == '' && n.authorName == '' && n.authorUsername == '' && n.authorColor == ''
            && getAfter(postPath()).data.commentCount == get(postPath()).data.commentCount - 1
            && getAfter(postPath()).data.lastCommentId == cid;
        }

        // Rich comments: text, one media item, or text + one media item. Only GIPHY GIFs, photos
        // in Cloudinary's lks/comment-media folder, or a sticker of one of the author's own Pals.
        function validMedia(m) {
          return m is map && m.kind is string && (
            (m.kind == 'gif' && m.keys().hasOnly(['kind', 'id', 'url', 'w', 'h']) && m.keys().hasAll(['kind', 'id', 'url'])
              && isStr(m.id, 1, 64) && isStr(m.url, 20, 300)
              && m.url.matches('^https://(media[0-9]?|i)[.]giphy[.]com/[A-Za-z0-9_./-]+$')
              && m.get('w', 1) is int && m.get('h', 1) is int)
            || (m.kind == 'photo' && m.keys().hasOnly(['kind', 'url', 'w', 'h']) && m.keys().hasAll(['kind', 'url'])
              && isStr(m.url, 20, 400)
              && m.url.matches('^https://res[.]cloudinary[.]com/zfmeldgm/image/upload/([A-Za-z0-9_,.:-]+/)*lks/comment-media/[A-Za-z0-9_-]+$')
              && m.get('w', 1) is int && m.get('h', 1) is int)
            || (m.kind == 'sticker' && m.keys().hasOnly(['kind', 'petId', 'pose']) && m.keys().hasAll(['kind', 'petId', 'pose'])
              && isStr(m.petId, 1, 100) && m.pose in ['wave', 'love', 'laugh', 'cry', 'wow', 'dance', 'sleepy']
              && exists(/databases/$(database)/documents/users/$(me())/pets/$(m.petId))));
        }
        function validBody(d) {
          return ('media' in d) ? (validMedia(d.media) && cleanStr(d.text, 0, 500)) : cleanStr(d.text, 1, 500);
        }

        allow read: if true;
        allow create: if signedIn() && notBanned() && canCreate(request.resource.data.authorId)
          && !blockedBy(get(postPath()).data.authorId)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorUsername', 'authorColor', 'text', 'createdAt',
                                                   'parentId', 'likeCount', 'replyCount', 'media'])
          && request.resource.data.authorId == me()
          && request.resource.data.authorName == me_().displayName
          && request.resource.data.authorUsername == me_().username
          && isStr(request.resource.data.authorColor, 1, 20)
          && validBody(request.resource.data)
          && (isAdmin() || linksOk(request.resource.data.text, me_()))
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('likeCount', 0) == 0
          && request.resource.data.get('replyCount', 0) == 0
          && (!('parentId' in request.resource.data) || validReplyTo(request.resource.data.parentId))
          && getAfter(postPath()).data.commentCount == get(postPath()).data.commentCount + 1
          && getAfter(postPath()).data.lastCommentId == cid
          && (isAdmin() || getAfter(userPath(me())).data.lastCommentAt == request.time)
          && !pcOff(getAfter(userPath(me())).data, 'cmt');
        allow update: if signedIn() && (cLikeChange() || replyChange() || softDelete());
        // Hard delete: the author, the admin or the post's owner. Replies update their parent's
        // count (unless the parent is gone); a comment with replies must be blanked instead.
        allow delete: if signedIn() && canModerate()
          && resource.data.get('deleted', false) == false
          && (('parentId' in resource.data)
              ? (!existsAfter(cPath(resource.data.parentId))
                 || (getAfter(cPath(resource.data.parentId)).data.get('replyCount', 0)
                       == get(cPath(resource.data.parentId)).data.get('replyCount', 0) - 1
                     && getAfter(cPath(resource.data.parentId)).data.lastReplyId == cid))
              : resource.data.get('replyCount', 0) == 0)
          && getAfter(postPath()).data.commentCount == get(postPath()).data.commentCount - 1;
        // Leftovers of a deleted post.
        allow delete: if signedIn() && !existsAfter(postPath());
        // A blank "Comment deleted" placeholder whose replies are all gone (it holds no content).
        allow delete: if signedIn() && resource.data.get('deleted', false) == true
          && resource.data.get('replyCount', 0) == 0;

        match /likes/{likerId} {
          function cmt() { return /databases/$(database)/documents/posts/$(postId)/comments/$(cid); }
          allow read: if true;
          allow create: if signedIn() && likerId == me()
            && request.resource.data.keys().hasOnly(['createdAt', 'uid'])
            && request.resource.data.uid == me()
            && request.resource.data.createdAt == request.time
            && get(cmt()).data.get('deleted', false) == false
            && getAfter(cmt()).data.likeCount == get(cmt()).data.get('likeCount', 0) + 1;
          allow delete: if signedIn() && likerId == me() && existsAfter(cmt())
            && getAfter(cmt()).data.likeCount == get(cmt()).data.get('likeCount', 0) - 1;
          // Leftovers of a deleted comment / post.
          allow delete: if signedIn() && (!existsAfter(cmt()) || !existsAfter(postPath()));
        }
      }
    }

    // Collection-group lookups used by account deletion: your comments anywhere, and the
    // notifications your own actions created in other people's inboxes.
    match /{path=**}/comments/{cid} {
      allow read: if true;
    }
    match /{path=**}/likes/{lid} {
      allow read: if true;
    }
    match /{path=**}/notifications/{nid} {
      allow read, delete: if signedIn() && resource.data.fromUid == me();
    }

    // ---------- Stories (24 h) ----------
    // Visible to the owner and their followers (not to people they blocked); studio stories are public.
    function canSeeStories(a) {
      return (a == 'studio' && (!signedIn() || !blockedBy(a)))
        || (signedIn() && (actingAs(a)
            || (exists(/databases/$(database)/documents/follows/$(me() + '_' + a)) && !blockedBy(a))));
    }
    function validStory(d) {
      let u = get(userPath(d.authorId)).data;
      return d.keys().hasOnly(['authorId', 'authorName', 'authorUsername', 'authorColor', 'mediaType', 'mediaUrl',
                               'posterUrl', 'width', 'height', 'duration', 'caption', 'cloudinaryPublicId',
                               'createdAt', 'expiresAt'])
        && d.keys().hasAll(['authorId', 'authorName', 'authorUsername', 'authorColor', 'mediaType', 'mediaUrl',
                            'posterUrl', 'width', 'height', 'duration', 'caption', 'cloudinaryPublicId',
                            'createdAt', 'expiresAt'])
        && d.authorName == u.displayName
        && d.authorUsername == u.username
        && d.authorColor == u.color
        && d.mediaType in ['image', 'video']
        && cloudinaryUrl(d.mediaUrl)
        && cloudinaryUrl(d.posterUrl)
        && d.width is int && d.width >= 0 && d.width <= 20000
        && d.height is int && d.height >= 0 && d.height <= 20000
        && d.duration is number && d.duration >= 0 && d.duration <= 16
        && (d.mediaType == 'video' || d.duration == 0)
        && cleanStr(d.caption, 0, 120)
        && isStr(d.cloudinaryPublicId, 1, 255)
        && d.cloudinaryPublicId.matches('^[A-Za-z0-9_./-]+$')
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(24, 'h')
        && getAfter(userPath(d.authorId)).data.lastPostAt == request.time;
    }
    match /stories/{sid} {
      allow read: if canSeeStories(resource.data.authorId);
      allow create: if signedIn() && notBanned() && actingAs(request.resource.data.authorId) && validStory(request.resource.data) && canCreate(request.resource.data.authorId)
        && !watched(request.resource.data.authorId);
      allow delete: if signedIn() && (actingAs(resource.data.authorId) || isAdmin());

      // Who viewed a story: written by each viewer, read by the owner.
      match /viewers/{v} {
        function story() { return get(/databases/$(database)/documents/stories/$(sid)).data; }
        allow read: if signedIn() && (v == me() || actingAs(story().authorId) || isAdmin());
        allow create: if signedIn() && v == me()
          && story().authorId != me()
          && canSeeStories(story().authorId)
          && request.resource.data.keys().hasOnly(['viewedAt', 'name', 'username', 'color'])
          && request.resource.data.viewedAt == request.time
          && request.resource.data.name == get(userPath(me())).data.displayName
          && request.resource.data.username == get(userPath(me())).data.username
          && isStr(request.resource.data.color, 1, 20);
        allow delete: if signedIn() && (v == me() || actingAs(story().authorId) || isAdmin());
      }
    }

    // ---------- Live streams (WebRTC peer-to-peer; Firestore only carries signaling + chat) ----------
    // lives/{id}: written only by the host (or the admin acting as the studio). The admin can also
    // end any live. A live with no heartbeat for ~60 s is treated as ended by the app.
    function validNewLive(d) {
      let u = get(userPath(d.hostId)).data;
      return d.keys().hasOnly(['hostId', 'hostName', 'hostUsername', 'hostColor', 'title', 'status', 'startedAt',
                               'heartbeatAt', 'viewerCount', 'peakViewers', 'totalViewers', 'starCount',
                               'type', 'youtubeId', 'chatOn'])
        // In-app (peer-to-peer) lives by default; "big lives" embed the host's own YouTube Live.
        // Anyone can start either for their own account (the create rule checks actingAs, so
        // only the admin can host as the studio).
        && (!('type' in d) || d.type in ['webrtc', 'youtube'])
        && (d.get('type', 'webrtc') == 'youtube'
            ? (d.youtubeId is string && d.youtubeId.matches('^[A-Za-z0-9_-]{11}$')
               && d.chatOn is bool)
            : (!('youtubeId' in d) && !('chatOn' in d)))
        && d.keys().hasAll(['hostId', 'hostName', 'hostUsername', 'hostColor', 'title', 'status', 'startedAt',
                            'heartbeatAt', 'viewerCount', 'peakViewers', 'totalViewers', 'starCount'])
        && d.hostName == u.displayName
        && d.hostUsername == u.username
        && d.hostColor == u.color
        && isStr(d.title, 0, 80)
        && d.status == 'live'
        && d.startedAt == request.time
        && d.heartbeatAt == request.time
        && d.viewerCount == 0 && d.peakViewers == 0 && d.totalViewers == 0 && d.starCount == 0
        && getAfter(userPath(d.hostId)).data.lastPostAt == request.time;
    }
    function maxViewers(o) { return o.get('type', 'webrtc') == 'youtube' ? 10000000 : 50; }
    function hostLiveUpdate() {
      let n = request.resource.data;
      let o = resource.data;
      return actingAs(o.hostId) && o.status == 'live'
        && changed().hasOnly(['heartbeatAt', 'viewerCount', 'peakViewers', 'totalViewers', 'starCount', 'status', 'endedAt', 'endedBy', 'palHidden'])
        && (!('palHidden' in n) || n.palHidden is bool)
        && n.heartbeatAt == request.time
        && n.viewerCount is int && n.viewerCount >= 0 && n.viewerCount <= maxViewers(o)
        && n.peakViewers is int && n.peakViewers >= o.peakViewers && n.peakViewers <= maxViewers(o)
        && n.totalViewers is int && n.totalViewers >= o.totalViewers && n.totalViewers <= 10000000
        && n.starCount is int && n.starCount >= o.starCount && n.starCount <= 10000000
        && ((n.status == 'live' && !('endedAt' in n) && !('endedBy' in n))
            || (n.status == 'ended' && n.endedAt == request.time && n.endedBy == 'host'));
    }
    function adminEndsLive() {
      return isAdmin() && resource.data.status == 'live'
        && changed().hasOnly(['status', 'endedAt', 'endedBy'])
        && request.resource.data.status == 'ended'
        && request.resource.data.endedAt == request.time
        && request.resource.data.endedBy == 'admin';
    }
    match /lives/{lid} {
      function live() { return get(/databases/$(database)/documents/lives/$(lid)).data; }
      function isHost() { return signedIn() && actingAs(live().hostId); }
      function liveOn() { return live().status == 'live'; }

      allow read: if true;
      allow create: if signedIn() && actingAs(request.resource.data.hostId) && validNewLive(request.resource.data) && canCreate(request.resource.data.hostId)
        && !pcOff(get(userPath(request.resource.data.hostId)).data, 'live');
      allow update: if signedIn() && (hostLiveUpdate() || adminEndsLive());
      allow delete: if signedIn() && (actingAs(resource.data.hostId) || isAdmin());

      // A viewer asks to join (their own doc only). The host caps the number of connections.
      match /viewers/{v} {
        allow read: if signedIn() && (v == me() || isHost() || isAdmin());
        allow create: if signedIn() && v == me() && liveOn()
          && live().hostId != me() && !blockedBy(live().hostId)
          && request.resource.data.keys().hasOnly(['name', 'username', 'color', 'joinedAt'])
          && request.resource.data.name == get(userPath(me())).data.displayName
          && request.resource.data.username == get(userPath(me())).data.username
          && isStr(request.resource.data.color, 1, 20)
          && request.resource.data.joinedAt == request.time;
        allow delete: if signedIn() && (v == me() || isHost() || isAdmin());
      }
      // The host's WebRTC offer for one viewer (or "full").
      match /conns/{v} {
        allow read: if signedIn() && (v == me() || isHost());
        allow create, update: if isHost()
          && request.resource.data.keys().hasOnly(['offer', 'full', 'createdAt'])
          && isStr(request.resource.data.offer, 0, 30000)
          && request.resource.data.full is bool
          && request.resource.data.createdAt == request.time;
        allow delete: if isHost() || (signedIn() && v == me());
      }
      // The viewer's WebRTC answer (their own doc only).
      match /answers/{v} {
        allow read: if signedIn() && (v == me() || isHost());
        allow create, update: if signedIn() && v == me() && liveOn()
          && request.resource.data.keys().hasOnly(['answer', 'createdAt'])
          && isStr(request.resource.data.answer, 1, 30000)
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (v == me() || isHost());
      }
      // Live chat + stars, tied to the signed-in author, max ~1 per second (lastMessageAt).
      match /chat/{c} {
        allow read: if true;
        allow create: if signedIn() && liveOn() && !blockedBy(live().hostId)
          && live().get('chatOn', true) == true
          && request.resource.data.keys().hasOnly(['authorId', 'name', 'username', 'color', 'type', 'text', 'count', 'createdAt'])
          && request.resource.data.authorId == me()
          && request.resource.data.name == get(userPath(me())).data.displayName
          && request.resource.data.username == get(userPath(me())).data.username
          && isStr(request.resource.data.color, 1, 20)
          && ((request.resource.data.type == 'msg' && cleanStr(request.resource.data.text, 1, 150) && !tooManyLinks(request.resource.data.text) && request.resource.data.count == 0)
              || (request.resource.data.type == 'star' && request.resource.data.text == ''
                  && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20))
          && request.resource.data.createdAt == request.time
          && getAfter(userPath(me())).data.lastMessageAt == request.time
          && !pcOff(getAfter(userPath(me())).data, 'chat');
        allow delete: if signedIn() && (isHost() || isMod() || resource.data.authorId == me());
      }
    }

    // ---------- Follows (id = followerUid_followeeUid) ----------
    match /follows/{fid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['follower', 'followee', 'createdAt'])
        && request.resource.data.follower == me()
        && request.resource.data.followee is string
        && request.resource.data.followee != me()
        && fid == me() + '_' + request.resource.data.followee
        && exists(userPath(request.resource.data.followee))
        && !blockedBy(request.resource.data.followee)
        // Anti-spam: each follow stamps lastFollowAt (max one per 2 s); following the studio at signup is exempt.
        && (request.resource.data.followee == 'studio' || isAdmin()
            || getAfter(userPath(me())).data.get('lastFollowAt', null) == request.time)
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && (resource.data.follower == me() || resource.data.followee == me() || isAdmin());
    }

    // ---------- Direct messages (id = sortedUidA_sortedUidB) ----------
    // The admin can read and reply to chats with the studio account ("studio").
    function isBlocked(owner, who) { return exists(/databases/$(database)/documents/users/$(owner)/blocks/$(who)); }
    match /chats/{chatId} {
      function parts() { return chatId.split('_'); }
      function otherOf(a) { return parts()[0] == a ? parts()[1] : parts()[0]; }
      function inChat() { return signedIn() && (me() in parts() || ('studio' in parts() && isAdmin())); }
      function chatPath() { return /databases/$(database)/documents/chats/$(chatId); }

      allow get: if inChat();
      allow list: if signedIn() && (me() in resource.data.participants
        || ('studio' in resource.data.participants && isAdmin()));
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['participants', 'lastMessage', 'lastAt', 'lastSender', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.lastSender in request.resource.data.participants
        && actingAs(request.resource.data.lastSender)
        && exists(userPath(otherOf(request.resource.data.lastSender)))
        && !pcNoDm(get(userPath(otherOf(request.resource.data.lastSender))).data)
        && !pcNoDm(getAfter(userPath(request.resource.data.lastSender)).data)
        && !isBlocked(otherOf(request.resource.data.lastSender), request.resource.data.lastSender)
        // DMs are friends-only: a new chat needs follows both ways (or the studio / a moderator).
        && ('studio' in request.resource.data.participants || isMod()
            || (exists(/databases/$(database)/documents/follows/$(request.resource.data.lastSender + '_' + otherOf(request.resource.data.lastSender)))
                && exists(/databases/$(database)/documents/follows/$(otherOf(request.resource.data.lastSender) + '_' + request.resource.data.lastSender))))
        && isStr(request.resource.data.lastMessage, 0, 1000)
        // Anti-spam: starting new conversations is limited (lastNewChatAt, one per 8 s).
        && ('studio' in request.resource.data.participants || isMod()
            || getAfter(userPath(request.resource.data.lastSender)).data.get('lastNewChatAt', null) == request.time)
        && request.resource.data.lastAt == request.time
        && request.resource.data.createdAt == request.time;
      allow update: if inChat()
        && changed().hasOnly(['lastMessage', 'lastAt', 'lastSender'])
        && isStr(request.resource.data.lastMessage, 0, 1000)
        && request.resource.data.lastSender in parts()
        && actingAs(request.resource.data.lastSender)
        && request.resource.data.lastAt == request.time
        && !isBlocked(otherOf(request.resource.data.lastSender), request.resource.data.lastSender);

      match /messages/{mid} {
        allow read: if inChat();
        allow create: if inChat() && notBanned()
          && ('studio' in parts() || canCreate(request.resource.data.senderId))
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'snap', 'viewed'])
          && (!('snap' in request.resource.data) || snapOk(request.resource.data))
          && (!('viewed' in request.resource.data) || ('snap' in request.resource.data && request.resource.data.viewed == false))
          && request.resource.data.senderId in parts()
          && actingAs(request.resource.data.senderId)
          && cleanStr(request.resource.data.text, 1, 1000)
          && ('studio' in parts() || linksOk(request.resource.data.text, get(userPath(request.resource.data.senderId)).data))
          && request.resource.data.createdAt == request.time
          && !isBlocked(otherOf(request.resource.data.senderId), request.resource.data.senderId)
          && getAfter(chatPath()).data.lastAt == request.time
          && getAfter(userPath(request.resource.data.senderId)).data.lastMessageAt == request.time
          && !pcNoDm(getAfter(userPath(request.resource.data.senderId)).data)
          && !pcNoDm(get(userPath(otherOf(request.resource.data.senderId))).data);
        // View-once snap: only the recipient can open it, which removes the media link for good.
        allow update: if inChat()
          && resource.data.get('viewed', true) == false
          && resource.data.senderId != me()
          && !(resource.data.senderId == 'studio' && isAdmin())
          && request.resource.data.viewed == true
          && !('snap' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewed', 'snap']);
        allow delete: if isMod() || leavingForGood();
      }
      function snapOk(d) {
        return d.snap is map && d.snap.keys().hasOnly(['url', 'kind', 'poster'])
          && d.snap.kind in ['image', 'video']
          && isStr(d.snap.url, 10, 500) && d.snap.url.matches('https://res[.]cloudinary[.]com/[a-z0-9_-]+/(image|video)/upload/.+')
          && (!('poster' in d.snap) || (isStr(d.snap.poster, 0, 500) && (d.snap.poster == '' || d.snap.poster.matches('https://res[.]cloudinary[.]com/.+'))));
      }
      // Account deletion: once your profile is gone, you can delete chats you were part of.
      function leavingForGood() { return signedIn() && me() in parts() && me() != 'studio' && !exists(userPath(me())); }
      allow delete: if leavingForGood();
    }

    // ---------- Games (js/games/*): turn-based multiplayer, no Cloud Functions ----------
    // Board games (stardrop, klgrid, checkers): two players, moves only on your turn, boards are
    // strings whose piece counts must change the way one legal move can. Trivia / Star Cards rooms:
    // the host's client runs the round (it is the referee); members write only their own intents,
    // answers and heartbeats. Results are written by participants with consistency checks.
    function gBoardType(t) { return t in ['stardrop', 'klgrid', 'checkers']; }
    function gTwoP(t) { return gBoardType(t) || t == 'pool' || t == 'chess'; }
    function gMax(t) { return gTwoP(t) ? 2 : t == 'trivia' ? 8 : t == 'ludo' ? 4 : 6; }
    // Chess: clocks in ms; the mover's clock may only go down by at least the real elapsed time.
    function gClockOk(o, n) {
      return o.clk.size() == 0 ? n.clk == o.clk
        : (n.clk is list && n.clk.size() == 2 && n.clk[o.turn] is int && n.clk[o.turn] >= 0
           && n.clk[o.turn] <= o.clk[o.turn] - (request.time.toMillis() - o.turnAt.toMillis()) + 3000
           && n.clk[1 - o.turn] == o.clk[1 - o.turn]);
    }
    function gTurnUp(o) {
      return o.type == 'chess' && o.clk.size() == 2
        ? request.time.toMillis() > o.turnAt.toMillis() + o.clk[o.turn] + 2000
        : request.time > o.turnAt + duration.value(65, 's');
    }
    // Ludo: commit-reveal dice. rv[uid] holds each human's latest hash-chain link, rk[uid] its
    // roll index; die = 1 + first hex digit 0-5 of sha256(reveals in seat order + roll index).
    function gIsBot(u) { return u.matches('^cpu[0-9]$'); }
    function gLRv(d, i) { return i < d.players.size() && !gIsBot(d.players[i]) ? d.rv[d.players[i]] : ''; }
    function gLRk(d, i) { return i >= d.players.size() || gIsBot(d.players[i]) || d.rk[d.players[i]] == d.lv.k; }
    function gLIn(d, i) { return i >= d.players.size() || gIsBot(d.players[i]) || d.players[i] in d.rv; }
    function gLReady(d) { return gLIn(d, 0) && gLIn(d, 1) && gLIn(d, 2) && gLIn(d, 3); }
    function gLDieOk(d, die) {
      return die is int && die >= 1 && die <= 6
        && hashing.sha256((gLRv(d, 0) + gLRv(d, 1) + gLRv(d, 2) + gLRv(d, 3) + string(d.lv.k)).toUtf8()).toHexString().lower()
             .matches('^[6-9a-f]*' + string(die - 1) + '.*');
    }
    function gLStart(d) {
      return d.players.size() >= 2 && gLReady(d) && d.lv.k == 0 && d.lv.turn == 0 && d.lv.n == d.players.size()
        && d.lv.p.matches('^(--)+$') && d.lv.p.size() == d.players.size() * 8 && d.moveNo == 0;
    }
    function gLSame(o, n, x, j) { return j >= o.players.size() || n.players[j] == o.players[j] || (o.players[j] == x && n.players[j] == 'cpu' + string(j)); }
    function gCount(s, re) { return s.replace(re, '').size(); }
    function gProfile() { return get(userPath(me())).data; }
    function gBoardOk(t, ob, nb, turn) {
      let mine = turn == 0 ? '[^a]' : '[^b]';
      let theirs = turn == 0 ? '[^b]' : '[^a]';
      let mineK = turn == 0 ? '[^aA]' : '[^bB]';
      let theirsK = turn == 0 ? '[^bB]' : '[^aA]';
      return nb is string && nb.size() == ob.size() && nb != ob
        && ((t == 'stardrop' && nb.matches('^[.ab]{42}$')
              && gCount(nb, mine) == gCount(ob, mine) + 1 && gCount(nb, theirs) == gCount(ob, theirs))
         || (t == 'klgrid' && (nb.matches('^[.ab]{9}$') || nb.matches('^[.ab]{81}$'))
              && gCount(nb, mine) == gCount(ob, mine) + 1 && gCount(nb, theirs) == gCount(ob, theirs))
         || (t == 'checkers' && nb.matches('^[.aAbB]{32}$')
              && gCount(nb, mineK) == gCount(ob, mineK) && gCount(nb, theirsK) <= gCount(ob, theirsK)));
    }
    function gCardsTotal(pv) {
      let c = pv.counts;
      return (c.size() > 0 ? c[0] : 0) + (c.size() > 1 ? c[1] : 0) + (c.size() > 2 ? c[2] : 0)
        + (c.size() > 3 ? c[3] : 0) + (c.size() > 4 ? c[4] : 0) + (c.size() > 5 ? c[5] : 0)
        + pv.deckCount + pv.discardCount;
    }
    function gSeatStep(o, n, i) { return i >= n.size() || i >= o.size() || (n[i] - o[i] <= 4 && o[i] - n[i] <= 1); }
    function gCountsOk(o, n) {
      return n.counts is list && n.counts.size() == request.resource.data.players.size() && gCardsTotal(n) == 108
        && (!('pv' in o) || o.pv.round != n.round
            || (gSeatStep(o.pv.counts, n.counts, 0) && gSeatStep(o.pv.counts, n.counts, 1) && gSeatStep(o.pv.counts, n.counts, 2)
                && gSeatStep(o.pv.counts, n.counts, 3) && gSeatStep(o.pv.counts, n.counts, 4) && gSeatStep(o.pv.counts, n.counts, 5)));
    }
    match /games/{gid} {
      function gPath() { return /databases/$(database)/documents/games/$(gid); }
      function nd() { return request.resource.data; }
      function od() { return resource.data; }
      function member() { return signedIn() && me() in resource.data.players; }
      function otherP() { return od().players[0] == me() ? od().players[1] : od().players[0]; }
      function hbOnly() {
        return changed().hasOnly(['hb']) && nd().hb.diff(od().hb).affectedKeys().hasOnly([me()])
          && nd().hb[me()] == request.time;
      }
      function validNames(d) {
        return d.players is list && d.players.size() >= 1 && d.players.size() <= gMax(d.type)
          && d.names is list && d.names.size() == d.players.size()
          && d.unames is list && d.unames.size() == d.players.size()
          && d.colors is list && d.colors.size() == d.players.size();
      }
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && nd().keys().hasOnly(['type', 'mode', 'status', 'players', 'names', 'unames', 'colors', 'host', 'invitee', 'quick',
                                'createdAt', 'updatedAt', 'winnerUid', 'endReason', 'rematch', 'hb', 'board', 'turn', 'moveNo',
                                'last', 'turnAt', 'round', 'qs', 'roundAt', 'roundLen', 'scores', 'pv', 'seedHash', 'seeds', 'intent', 'call', 'from',
                                'pos', 'ps', 'shot', 'cx', 'ml', 'clk', 'lv', 'rv', 'rk', 'left'])
        && nd().type in ['stardrop', 'klgrid', 'checkers', 'trivia', 'starcards', 'pool', 'chess', 'ludo']
        && isStr(nd().mode, 0, 20)
        && nd().status == 'waiting' && nd().host == me() && nd().players[0] == me() && validNames(nd())
        && nd().names[0] == gProfile().displayName && nd().unames[0] == gProfile().username
        && isStr(nd().invitee, 0, 128) && nd().quick is bool
        && nd().createdAt == request.time && nd().winnerUid == '' && nd().rematch == ''
        && (!gBoardType(nd().type) || (nd().players.size() == 1 && nd().board.matches('^[.]{9}$|^[.]{42}$|^[.]{81}$|^b{12}[.]{8}a{12}$')
                                        && nd().turn == 0 && nd().moveNo == 0))
        && (nd().type != 'pool' || (nd().players.size() == 1 && nd().pos is string && nd().pos.matches('^[0-9]{128}$')
                                    && nd().turn == 0 && nd().moveNo == 0 && isStr(nd().ps, 2, 400)))
        && (nd().type != 'chess' || (nd().players.size() == 1 && nd().board == 'rnbqkbnrpppppppp' + '................................' + 'PPPPPPPPRNBQKBNR'
                                     && nd().cx == 'w KQkq - 0 1' && nd().ml == '' && nd().turn == 0 && nd().moveNo == 0
                                     && nd().clk == (nd().mode == '5' ? [300000, 300000] : nd().mode == '10' ? [600000, 600000] : [])))
        && (nd().type != 'ludo' || (nd().mode in ['2', '3', '4'] && nd().lv == null && nd().rv == {} && nd().rk == {} && nd().left == [] && nd().moveNo == 0));
      allow update: if signedIn() && (
        // heartbeat
        (member() && hbOnly())
        // Chess move: only the side to move; shape checks on the board (one king each, the mover
        // keeps all pieces, the other side loses at most one), clock can't go up.
        || (od().type == 'chess' && member() && od().status == 'active' && od().players[od().turn] == me()
            && changed().hasOnly(['board', 'cx', 'ml', 'clk', 'last', 'turn', 'moveNo', 'turnAt', 'updatedAt', 'status', 'winnerUid', 'endReason'])
            && nd().moveNo == od().moveNo + 1 && nd().turn == 1 - od().turn && nd().turnAt == request.time
            && nd().board is string && nd().board.matches('^[.PNBRQKpnbrqk]{64}$') && nd().board != od().board
            && gCount(nd().board, '[^K]') == 1 && gCount(nd().board, '[^k]') == 1
            && gCount(nd().board, od().turn == 0 ? '[^PNBRQK]' : '[^pnbrqk]') == gCount(od().board, od().turn == 0 ? '[^PNBRQK]' : '[^pnbrqk]')
            && gCount(nd().board, od().turn == 0 ? '[^pnbrqk]' : '[^PNBRQK]') <= gCount(od().board, od().turn == 0 ? '[^pnbrqk]' : '[^PNBRQK]')
            && gCount(nd().board, od().turn == 0 ? '[^pnbrqk]' : '[^PNBRQK]') >= gCount(od().board, od().turn == 0 ? '[^pnbrqk]' : '[^PNBRQK]') - 1
            && nd().cx.matches('^' + (nd().turn == 0 ? 'w' : 'b') + ' (-|[KQkq]{1,4}) (-|[0-9]{1,2}) [0-9]{1,3} [0-9]{1,4}$')
            && nd().last.matches('^[0-9]{1,2}-[0-9]{1,2}(-[1-4])?$')
            && isStr(nd().ml, 3, 8000) && nd().ml.size() > od().ml.size()
            && gClockOk(od(), nd())
            && ((nd().status == 'active' && nd().winnerUid == '')
                || (nd().status == 'done' && ((nd().winnerUid == me() && nd().endReason == 'win') || (nd().winnerUid == 'draw' && nd().endReason == 'draw')))))
        // Ludo: commit to a hash chain before the game starts
        || (od().type == 'ludo' && member() && od().status == 'waiting' && changed().hasOnly(['rv', 'rk', 'updatedAt'])
            && !(me() in od().rv) && nd().rv.diff(od().rv).affectedKeys().hasOnly([me()]) && nd().rk.diff(od().rk).affectedKeys().hasOnly([me()])
            && nd().rv[me()] is string && nd().rv[me()].matches('^[0-9a-f]{64}$') && nd().rk[me()] == -1)
        // Ludo: reveal the next link for the current roll (must hash to the previous link)
        || (od().type == 'ludo' && member() && od().status == 'active' && changed().hasOnly(['rv', 'rk', 'updatedAt'])
            && nd().rv.diff(od().rv).affectedKeys().hasOnly([me()]) && nd().rk.diff(od().rk).affectedKeys().hasOnly([me()])
            && nd().rk[me()] == od().rk[me()] + 1 && nd().rk[me()] == od().lv.k
            && nd().rv[me()] is string && nd().rv[me()].size() == 64
            && hashing.sha256(nd().rv[me()].toUtf8()).toHexString().lower() == od().rv[me()])
        // Ludo: the player to move (or the host for a computer seat) applies the fair roll
        || (od().type == 'ludo' && member() && od().status == 'active'
            && (od().players[od().lv.turn] == me() || (gIsBot(od().players[od().lv.turn]) && od().host == me()))
            && changed().hasOnly(['lv', 'moveNo', 'turnAt', 'updatedAt', 'status', 'winnerUid', 'endReason'])
            && nd().moveNo == od().moveNo + 1 && nd().turnAt == request.time
            && nd().lv.k == od().lv.k + 1 && nd().lv.n == od().lv.n
            && nd().lv.turn is int && nd().lv.turn >= 0 && nd().lv.turn < od().players.size()
            && nd().lv.p is string && nd().lv.p.size() == od().lv.p.size() && nd().lv.p.matches('^([0-5][0-9]|--)+$')
            && gLRk(od(), 0) && gLRk(od(), 1) && gLRk(od(), 2) && gLRk(od(), 3)
            && gLDieOk(od(), nd().lv.die)
            && ((nd().status == 'active' && nd().winnerUid == '' && nd().lv.winner == -1)
                || (nd().status == 'done' && nd().endReason == 'win' && nd().lv.winner == od().lv.turn && nd().winnerUid == od().players[od().lv.turn])))
        // Ludo: leave (yourself) or replace a player who blocks the game for a full turn with a computer player
        || (od().type == 'ludo' && member() && od().status == 'active'
            && changed().hasOnly(['players', 'names', 'unames', 'colors', 'left', 'turnAt', 'updatedAt'])
            && nd().turnAt == request.time && validNames(nd()) && nd().players.size() == od().players.size()
            && nd().left.size() == od().left.size() + 1 && nd().left == od().left.concat([nd().left[nd().left.size() - 1]])
            && nd().left[nd().left.size() - 1] in od().players && !(nd().left[nd().left.size() - 1] in nd().players)
            && !gIsBot(nd().left[nd().left.size() - 1])
            && gLSame(od(), nd(), nd().left[nd().left.size() - 1], 0) && gLSame(od(), nd(), nd().left[nd().left.size() - 1], 1)
            && gLSame(od(), nd(), nd().left[nd().left.size() - 1], 2) && gLSame(od(), nd(), nd().left[nd().left.size() - 1], 3)
            && (nd().left[nd().left.size() - 1] == me()
                || (request.time > od().turnAt + duration.value(60, 's')
                    && (nd().left[nd().left.size() - 1] == od().players[od().lv.turn] || od().rk[nd().left[nd().left.size() - 1]] < od().lv.k))
                || (nd().left[nd().left.size() - 1] in od().hb && od().hb[nd().left[nd().left.size() - 1]] < request.time - duration.value(45, 's'))))
        // join a waiting game / room
        || (!member() && od().status == 'waiting' && od().invitee in ['', me()]
            && changed().hasOnly(['players', 'names', 'unames', 'colors', 'status', 'turnAt', 'updatedAt'])
            && nd().players == od().players.concat([me()]) && validNames(nd())
            && nd().names == od().names.concat([gProfile().displayName])
            && nd().unames == od().unames.concat([gProfile().username])
            && ((gTwoP(od().type) && nd().status == 'active' && nd().turnAt == request.time)
                || (!gTwoP(od().type) && nd().status == 'waiting')))
        // board move (only the player whose turn it is)
        || (member() && gBoardType(od().type) && od().status == 'active' && od().players[od().turn] == me()
            && changed().hasOnly(['board', 'turn', 'moveNo', 'last', 'turnAt', 'updatedAt', 'status', 'winnerUid', 'endReason'])
            && nd().moveNo == od().moveNo + 1 && nd().turn == 1 - od().turn && nd().turnAt == request.time
            && isStr(nd().last, 1, 60) && nd().last.matches('^[0-9-]+$')
            && gBoardOk(od().type, od().board, nd().board, od().turn)
            && ((nd().status == 'active' && nd().winnerUid == '')
                || (nd().status == 'done' && ((nd().winnerUid == me() && nd().endReason == 'win') || (nd().winnerUid == 'draw' && nd().endReason == 'draw')))))
        // Star Pool shot: the shooter writes the shot and the resulting positions (both clients
        // simulate the same deterministic physics). Balls can only leave the table, never come back,
        // except on the break (an 8 dropped on the break is re-spotted).
        || (od().type == 'pool' && member() && od().status == 'active' && od().players[od().turn] == me()
            && changed().hasOnly(['pos', 'ps', 'shot', 'turn', 'moveNo', 'turnAt', 'updatedAt', 'status', 'winnerUid', 'endReason'])
            && nd().moveNo == od().moveNo + 1 && nd().turn in [0, 1] && nd().turnAt == request.time
            && nd().pos is string && nd().pos.matches('^([0-9]{8}|-{8}){16}$') && nd().pos.matches('^[0-9]{8}.*')
            && isStr(nd().ps, 2, 400)
            && nd().shot is map && nd().shot.keys().hasOnly(['vx', 'vy', 'follow', 'side', 'from', 'by']) && nd().shot.by == od().turn
            && (od().moveNo == 0 || gCount(nd().pos, '[^-]') >= gCount(od().pos, '[^-]'))
            && ((nd().status == 'active' && nd().winnerUid == '')
                || (nd().status == 'done' && nd().winnerUid in od().players
                    && ((nd().winnerUid == me() && nd().endReason == 'win') || (nd().winnerUid == otherP() && nd().endReason == 'loss')))))
        // forfeit (board games) or claim a win when the other player timed out / disappeared
        || (member() && gTwoP(od().type) && od().status == 'active' && nd().status == 'done'
            && changed().hasOnly(['status', 'winnerUid', 'endReason', 'updatedAt'])
            && ((nd().endReason == 'forfeit' && nd().winnerUid == otherP())
                || (nd().endReason == 'timeout' && nd().winnerUid == me() && od().players[od().turn] != me()
                    && (gTurnUp(od())
                        || (otherP() in od().hb && od().hb[otherP()] < request.time - duration.value(45, 's'))))))
        // cancel a waiting board game nobody joined
        || (member() && od().host == me() && od().status == 'waiting' && nd().status == 'done'
            && changed().hasOnly(['status', 'endReason', 'updatedAt']) && nd().endReason == 'cancelled')
        // link a rematch once
        || (member() && od().status == 'done' && changed().hasOnly(['rematch', 'updatedAt'])
            && od().rematch == '' && isStr(nd().rematch, 1, 40))
        // room host runs Trivia / Star Cards (lobby seats incl. computer players, rounds, scores)
        || (member() && !gTwoP(od().type) && od().host == me() && od().status != 'done'
            && nd().host == me() && nd().players[0] == od().players[0] && validNames(nd())
            && (od().status == 'waiting' || (nd().players == od().players && nd().names == od().names))
            && nd().status in ['waiting', 'active', 'done']
            && (nd().status != 'done' || nd().winnerUid in nd().players || nd().winnerUid == 'draw')
            && !changed().hasAny(['type', 'createdAt', 'from'])
            && (od().type != 'ludo' || (od().status == 'waiting' && !changed().hasAny(['rv', 'rk', 'left'])
                                        && (nd().status == 'waiting' || (nd().status == 'active' && gLStart(nd())))))
            && (od().type != 'starcards' || !('pv' in nd()) || gCountsOk(od(), nd().pv)))
        // host migration when the host's heartbeat is stale
        || (member() && !gTwoP(od().type) && od().status != 'done' && changed().hasOnly(['host', 'hb'])
            && nd().host == me() && od().hb[od().host] < request.time - duration.value(30, 's')
            && nd().hb[me()] == request.time)
        // Star Cards: a seated player sends an intent (play/draw/pass) or a call (LAST STAR! / catch)
        || (member() && od().type == 'starcards' && od().status == 'active'
            && ((changed().hasOnly(['intent', 'updatedAt']) && nd().intent.uid == me()
                 && nd().intent.keys().hasOnly(['uid', 't', 'card', 'color', 'last', 'n'])
                 && nd().intent.t in ['play', 'draw', 'pass'] && od().players[od().pv.turn] == me())
             || (changed().hasOnly(['call', 'updatedAt']) && nd().call.uid == me()
                 && nd().call.keys().hasOnly(['uid', 't', 'n']) && nd().call.t in ['last', 'catch'])))
      );
      allow delete: if isAdmin();

      // Quick-chat emotes from players and signed-in spectators (preset ids only).
      match /chat/{cid} {
        allow read: if true;
        allow create: if signedIn() && !pcOff(get(userPath(me())).data, 'chat') && request.resource.data.keys().hasOnly(['uid', 'e', 'at'])
          && request.resource.data.uid == me() && request.resource.data.e is int
          && ((request.resource.data.e >= 0 && request.resource.data.e <= 9) || (request.resource.data.e >= 100 && request.resource.data.e <= 199)) && request.resource.data.at == request.time; // 100+: Pal emote (game-emotes.js)
        allow delete: if isAdmin();
      }
      // Trivia answers: one doc per player, overwritten each round; only you and the host read it.
      match /answers/{uid} {
        function room() { return get(gPath()).data; }
        allow read: if signedIn() && (me() == uid || me() == room().host);
        allow create, update: if signedIn() && me() == uid && uid in room().players && room().status == 'active'
          && room().type == 'trivia'
          && request.resource.data.keys().hasOnly(['round', 'choice', 'at'])
          && request.resource.data.round == room().round && request.resource.data.choice is int
          && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && request.resource.data.at == request.time
          && request.time < room().roundAt + duration.value(room().roundLen + 3, 's')
          && (resource == null || resource.data.round != request.resource.data.round);
        allow delete: if isAdmin();
      }
      // Star Cards hands: hands/{uid} readable only by that player (and the host who deals);
      // hands/_dealer holds the shuffled pile + seed, readable only by the host until revealed.
      match /hands/{hid} {
        function room() { return getAfter(gPath()).data; }
        allow read: if signedIn() && (me() == hid || me() == get(gPath()).data.host);
        allow write: if signedIn() && me() == room().host && room().type == 'starcards'
          && (hid == '_dealer'
              || (request.resource.data.keys().hasOnly(['hand', 'seat', 'drawn', 'dealt', 'round'])
                  && request.resource.data.seat is int && room().players[request.resource.data.seat] == hid
                  && request.resource.data.hand is list
                  && request.resource.data.hand.size() == room().pv.counts[request.resource.data.seat]));
      }
      // Result receipts: one per player per game, so a result is counted once.
      match /rec/{uid} {
        allow read: if true;
        allow create: if signedIn() && (me() in getAfter(gPath()).data.players || me() in getAfter(gPath()).data.get('left', []))
          && (uid in getAfter(gPath()).data.players || uid in getAfter(gPath()).data.get('left', []))
          && getAfter(gPath()).data.status == 'done'
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/gameStats/$(uid)).data.last == gid;
      }
    }

    // ---------- Scoreboards: leaderboard/{uid}_{game}, written only by that player ----------
    // Scores only go up, by at most one game's worth per write (win 3 / draw 1; Bubble Quest stars <= 300),
    // at most one write per doc every 10 s (3 s for Bubble Quest + Overall), with per-game bounds.
    match /leaderboard/{docId} {
      function lb() { return request.resource.data; }
      function lbOld() { return resource.data; }
      function lbBig(g) { return g == 'quest' || g == 'all'; }
      function lbCap(g) { return lbBig(g) ? 300 : 3; }
      function lbMaxBest(g) { return g == 'quest' ? 500 : g == 'trivia' ? 50000 : g == 'pals' ? 10000 : 1000000; }
      function lbN(v, hi) { return v is int && v >= 0 && v <= hi; }
      function lbUp(f, hi) { return lb()[f] >= lbOld()[f] && lb()[f] - lbOld()[f] <= hi; }
      function lbShape() {
        return lb().keys().hasOnly(['uid', 'game', 'name', 'uname', 'color', 'pal', 'score', 'wins', 'losses', 'draws', 'games', 'best', 'wk', 'wkScore', 'updatedAt'])
          && lb().keys().hasAll(['uid', 'game', 'name', 'uname', 'color', 'score', 'wins', 'losses', 'draws', 'games', 'best', 'wk', 'wkScore', 'updatedAt'])
          && lb().uid == me()
          && lb().game in ['stardrop', 'starcards', 'pool', 'chess', 'ludo', 'trivia', 'klgrid', 'checkers', 'pals', 'quest', 'all']
          && docId == me() + '_' + lb().game
          && lb().name == get(userPath(me())).data.displayName && lb().uname == get(userPath(me())).data.username
          && isStr(lb().color, 0, 20)
          && (!('pal' in lb()) || lb().pal == null || (lb().pal is map && lb().pal.size() <= 8 && isStr(lb().pal.get('species', ''), 0, 30) && isStr(lb().pal.get('name', ''), 0, 30)))
          && lbN(lb().score, 1000000) && lbN(lb().wins, 100000) && lbN(lb().losses, 100000) && lbN(lb().draws, 100000) && lbN(lb().games, 1000000)
          && lbN(lb().best, lbMaxBest(lb().game))
          && lb().wk is string && lb().wk.matches('^[0-9]{4}-W[0-9]{2}$') && lbN(lb().wkScore, 1000000) && lb().wkScore <= lb().score
          && (lb().game != 'quest' || lb().score <= lb().games * 300)
          && (lbBig(lb().game) || lb().score <= lb().games * 3)
          && lb().updatedAt == request.time;
      }
      allow read: if true;
      allow create: if signedIn() && lbShape()
        && lb().score <= (lbBig(lb().game) ? 3000 : 3) && lb().games <= 1 && lb().wins <= 1 && lb().losses <= 1 && lb().draws <= 1;
      allow update: if signedIn() && lbOld().uid == me() && lbShape() && lb().game == lbOld().game
        && lbUp('score', lbCap(lb().game)) && lbUp('games', 1) && lbUp('wins', 1) && lbUp('losses', 1) && lbUp('draws', 1)
        && lb().best >= lbOld().best
        && lbOld().updatedAt + duration.value(lbBig(lb().game) ? 3 : 10, 's') < request.time
        && (lb().wk == lbOld().wk ? lbUp('wkScore', lbCap(lb().game)) : lb().wkScore <= lbCap(lb().game));
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---------- Game records (wins / losses / draws per game) ----------
    match /gameStats/{uid} {
      function gs() { return request.resource.data; }
      function gG() { return getAfter(/databases/$(database)/documents/games/$(gs().last)).data; }
      function gKey() { return gG().type + '_' + (gG().winnerUid == uid ? 'w' : gG().winnerUid == 'draw' ? 'd' : 'l'); }
      function gFresh() {
        return !exists(/databases/$(database)/documents/games/$(gs().last)/rec/$(uid))
          && existsAfter(/databases/$(database)/documents/games/$(gs().last)/rec/$(uid));
      }
      function gOk() {
        return signedIn() && isStr(gs().last, 1, 40) && gG().status == 'done'
          && (uid in gG().players || uid in gG().get('left', [])) && (me() in gG().players || me() in gG().get('left', [])) && gFresh()
          && gs().updatedAt == request.time
          && gs().name == get(userPath(uid)).data.displayName && gs().uname == get(userPath(uid)).data.username
          && isStr(gs().color, 0, 20);
      }
      allow read: if true;
      allow create: if gOk() && gs().keys().hasOnly([gKey(), 'last', 'updatedAt', 'name', 'uname', 'color']) && gs()[gKey()] == 1;
      allow update: if gOk() && changed().hasOnly([gKey(), 'last', 'updatedAt', 'name', 'uname', 'color'])
        && gs()[gKey()] == resource.data.get(gKey(), 0) + 1;
      allow delete: if isAdmin() || (signedIn() && uid == me());
    }

    // ---------- Quick-match queue: one slot per game type ----------
    match /gameQueue/{qid} {
      allow read: if signedIn();
      allow write: if signedIn() && notBanned() && qid.matches('^[a-z-]{3,30}$')
        && request.resource.data.keys().hasOnly(['gid', 'uid', 'at'])
        && request.resource.data.uid in [me(), ''] && isStr(request.resource.data.gid, 0, 40)
        && request.resource.data.at == request.time;
    }

    // ---------- Series (Community Movies seasons + episodes) ----------
    // A series is a playlist of the owner's own movie posts: episodes = [{p: postId, s: season, e: episode}],
    // postIds mirrors the ids (for "which series is this movie in" lookups). Only the owner (or the
    // admin acting as 'studio' for Lone Keem Studios Originals) edits it; followers change only
    // followerCount, by exactly one, tied to their own followers/{uid} doc.
    match /series/{sid} {
      function sd() { return request.resource.data; }
      function validSeries(d) {
        return d.keys().hasOnly(['ownerId', 'ownerName', 'ownerUsername', 'ownerColor', 'title', 'desc', 'genre', 'aiTools',
                                 'rating', 'cover', 'seasons', 'episodes', 'postIds', 'followerCount', 'episodeCount',
                                 'lastAddedId', 'ai', 'createdAt', 'updatedAt'])
          && isStr(d.title, 1, 80) && isStr(d.desc, 0, 1000) && isStr(d.genre, 1, 30) && isStr(d.aiTools, 0, 100)
          && d.rating in ['all', '13', '16', '18']
          && (d.cover == '' || cloudinaryImageUrl(d.cover) || (d.cover is string && d.cover.matches('^https://i[.]ytimg[.]com/vi/[A-Za-z0-9_-]{6,20}/[a-z]+[.]jpg$')))
          && d.seasons is int && d.seasons >= 1 && d.seasons <= 30
          && d.episodes is list && d.episodes.size() <= 300
          && d.postIds is list && d.postIds.size() == d.episodes.size()
          && d.episodeCount == d.episodes.size()
          && (!('ai' in d) || (d.ai is map && d.ai.keys().hasOnly(['style', 'seed', 'cast', 'look'])))
          && d.updatedAt == request.time;
      }
      // The movie that was just added must be a movie post by the series owner.
      function addedOk(d) {
        return !('lastAddedId' in d) || d.lastAddedId == ''
          || (resource != null && d.lastAddedId == resource.data.get('lastAddedId', ''))
          || (d.lastAddedId in d.postIds
              && get(/databases/$(database)/documents/posts/$(d.lastAddedId)).data.authorId == d.ownerId
              && get(/databases/$(database)/documents/posts/$(d.lastAddedId)).data.type == 'movie');
      }
      allow read: if true;
      allow create: if actingAs(sd().ownerId) && validSeries(sd())
        && sd().followerCount == 0 && sd().createdAt == request.time && addedOk(sd())
        && (sd().ownerId == 'studio'
            || (sd().ownerName == get(userPath(me())).data.displayName && sd().ownerUsername == get(userPath(me())).data.username));
      allow update: if (actingAs(resource.data.ownerId) && validSeries(sd())
                        && sd().ownerId == resource.data.ownerId && sd().createdAt == resource.data.createdAt
                        && sd().followerCount == resource.data.followerCount && addedOk(sd()))
        || (signedIn() && changed().hasOnly(['followerCount'])
            && ((sd().followerCount == resource.data.followerCount + 1
                 && !exists(/databases/$(database)/documents/series/$(sid)/followers/$(me()))
                 && existsAfter(/databases/$(database)/documents/series/$(sid)/followers/$(me())))
             || (sd().followerCount == resource.data.followerCount - 1
                 && exists(/databases/$(database)/documents/series/$(sid)/followers/$(me()))
                 && !existsAfter(/databases/$(database)/documents/series/$(sid)/followers/$(me())))));
      allow delete: if actingAs(resource.data.ownerId) || isAdmin();

      match /followers/{fid} {
        allow read: if signedIn() && (fid == me() || actingAs(get(/databases/$(database)/documents/series/$(sid)).data.ownerId) || isAdmin());
        allow create: if signedIn() && fid == me()
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == me() && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/series/$(sid)).data.followerCount
               == get(/databases/$(database)/documents/series/$(sid)).data.followerCount + 1;
        allow delete: if signedIn() && (fid == me() || isAdmin()
          || !existsAfter(/databases/$(database)/documents/series/$(sid))
          || actingAs(get(/databases/$(database)/documents/series/$(sid)).data.ownerId));
      }
    }
    match /{path=**}/followers/{fid} {
      allow read: if signedIn() && resource.data.uid == me();
    }
    // Private "continue watching" progress per user and episode.
    match /users/{uid}/watch/{postId} {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['sid', 't', 'dur', 'at'])
        && isStr(request.resource.data.sid, 0, 100)
        && request.resource.data.t is number && request.resource.data.t >= 0 && request.resource.data.t <= 100000
        && request.resource.data.dur is number && request.resource.data.dur >= 0 && request.resource.data.dur <= 100000
        && request.resource.data.at == request.time;
    }

    // ---------- Reports (admin only can read) ----------
    function strikePath(u) { return /databases/$(database)/documents/reportStrikes/$(u); }
    function quotaPath(u) { return /databases/$(database)/documents/reportQuota/$(u); }
    function reportsAllowed() { return !exists(strikePath(me())) || get(strikePath(me())).data.until <= request.time; }
    function quotaBumped() {
      let q = getAfter(quotaPath(me())).data;
      return q.at == request.time && q.hN <= 10 && q.dN <= 30;
    }
    // Report rate counter, bumped by the reporter together with each report.
    match /reportQuota/{uid} {
      function q() { return request.resource.data; }
      function win(start, n, oldStart, oldN, secs) {
        return (oldStart > request.time - duration.value(secs, 's') && start == oldStart && n == oldN + 1)
          || (oldStart <= request.time - duration.value(secs, 's') && start == request.time && n == 1);
      }
      allow read: if signedIn() && (uid == me() || isMod());
      allow create: if signedIn() && uid == me() && q().keys().hasOnly(['hStart', 'hN', 'dStart', 'dN', 'at'])
        && q().at == request.time && q().hStart == request.time && q().dStart == request.time && q().hN == 1 && q().dN == 1;
      allow update: if signedIn() && uid == me() && q().keys().hasOnly(['hStart', 'hN', 'dStart', 'dN', 'at'])
        && q().at == request.time
        && win(q().hStart, q().hN, resource.data.hStart, resource.data.hN, 3600)
        && win(q().dStart, q().dN, resource.data.dStart, resource.data.dN, 86400);
    }
    // False-report strikes (mod-controlled; the user can only read their own).
    // n = total strikes, times = recent strike times, until = reporting blocked until,
    // blocks = how many report blocks so far, flag = flagged for the admin.
    // Kemy Helper may only ADD one strike; only the admin / human moderators undo.
    match /reportStrikes/{uid} {
      function sd() { return request.resource.data; }
      function validStrikes() {
        return sd().keys().hasOnly(['n', 'times', 'until', 'blocks', 'flag', 'by', 'at'])
          && sd().n is int && sd().n >= 1 && sd().n <= 1000
          && sd().times is list && sd().times.size() <= 20
          && sd().until is timestamp && sd().until <= request.time + duration.value(31, 'd')
          && sd().blocks is int && sd().blocks >= 0 && sd().flag is bool
          && sd().by == me() && sd().at == request.time;
      }
      allow read: if signedIn() && (uid == me() || isMod());
      allow create: if isMod() && uid != me() && validStrikes() && sd().n == 1;
      allow update: if isMod() && uid != me() && validStrikes() && (!isAI() || sd().n == resource.data.n + 1);
      allow delete: if isMod() && !isAI();
    }
    match /reports/{rid} {
      allow read, delete: if isMod();
      allow create: if signedIn()
        // Reports about someone else: not while report-blocked (false-report strikes), and counted
        // in reportQuota/{me} in the same batch (10 per hour, 30 per day). Auto self-reports and
        // moderators skip both.
        && (isMod() || request.resource.data.get('targetUid', '') == me() || (reportsAllowed() && quotaBumped()))
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'postId', 'reason', 'excerpt', 'createdAt', 'targetUid', 'status'])
        && request.resource.data.reporterId == me()
        && request.resource.data.targetType in ['post', 'comment', 'user', 'live', 'live chat', 'series', 'movie', 'song', 'chat message']
        && isStr(request.resource.data.targetId, 1, 200)
        && isStr(request.resource.data.postId, 0, 200)
        && isStr(request.resource.data.reason, 1, 500)
        && isStr(request.resource.data.excerpt, 0, 300)
        && isStr(request.resource.data.get('targetUid', ''), 0, 128)
        && request.resource.data.get('status', 'open') == 'open'
        && request.resource.data.createdAt == request.time;
      // Moderators move a report through open -> review -> resolved.
      allow update: if isMod()
        && changed().hasOnly(['status', 'handledBy', 'handledAt', 'action'])
        && request.resource.data.status in ['open', 'review', 'resolved']
        && request.resource.data.handledBy == me() && request.resource.data.handledAt == request.time
        && isStr(request.resource.data.get('action', ''), 0, 40);
    }

    // ∞ Pass (unlimited Star Coins + Diamonds): public (profile badge), written ONLY by the admin.
    match /infPass/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['unlimitedPass', 'grantedBy', 'grantedAt'])
        && request.resource.data.unlimitedPass == true && request.resource.data.grantedBy == me()
        && request.resource.data.grantedAt == request.time;
      allow delete: if isAdmin();
    }
    // Moderator roles: public (so everyone sees the blue check), written ONLY by the admin.
    match /roles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['mod', 'name', 'uname', 'by', 'at', 'ai'])
        && request.resource.data.get('ai', false) is bool
        && request.resource.data.mod == true
        && isStr(request.resource.data.name, 0, 60) && isStr(request.resource.data.uname, 0, 30)
        && request.resource.data.by == me() && request.resource.data.at == request.time;
      // Accepting an invite: the invited user creates their own role in the same batch that flips
      // their pending invite to accepted.
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['mod', 'name', 'uname', 'by', 'at'])
        && request.resource.data.mod == true
        && isStr(request.resource.data.name, 0, 60) && isStr(request.resource.data.uname, 0, 30)
        && exists(/databases/$(database)/documents/modInvites/$(uid))
        && get(/databases/$(database)/documents/modInvites/$(uid)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/modInvites/$(uid)).data.status == 'accepted'
        && request.resource.data.by == get(/databases/$(database)/documents/modInvites/$(uid)).data.by
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
    // Moderator invites: only the admin creates / cancels; the invited user can only answer their own
    // pending invite (accepted / declined).
    match /modInvites/{uid} {
      function iv() { return request.resource.data; }
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow create, update: if isAdmin() && uid != me()
        && iv().keys().hasOnly(['status', 'by', 'at', 'name', 'uname', 'answeredAt'])
        && iv().status in ['pending', 'cancelled'] && iv().by == me() && iv().at == request.time
        && isStr(iv().name, 0, 60) && isStr(iv().uname, 0, 30) && !('answeredAt' in iv());
      allow update: if signedIn() && uid == me() && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'answeredAt']) && iv().status in ['accepted', 'declined']
        && iv().answeredAt == request.time;
      allow delete: if isAdmin();
    }
    // Suspensions. Readable by the person themselves and moderators. Moderators can't suspend
    // themselves or other moderators (only the admin can).
    // Under-13 flag: moderators and the Kemy Helper mark; only the admin / human moderators undo.
    match /underage/{uid} {
      allow read: if signedIn() && (uid == me() || isMod());
      allow create: if isMod() && uid != me() && !exists(rolePath(uid))
        && request.resource.data.keys().hasOnly(['by', 'reason', 'at'])
        && request.resource.data.by == me() && isStr(request.resource.data.reason, 0, 200)
        && request.resource.data.at == request.time;
      allow delete: if isMod() && !isAI();
    }
    match /bans/{uid} {
      allow read: if signedIn() && (uid == me() || isMod());
      allow create, update: if isMod() && uid != me() && (isAdmin() || !exists(rolePath(uid)))
        // the AI helper: temporary suspensions of at most 7 days, never permanent / hidden
        && (!isAI() || (request.resource.data.permanent == false && request.resource.data.hide == false
                        && request.resource.data.until <= request.time + duration.value(7 * 24 * 60 + 5, 'm')))
        && request.resource.data.keys().hasOnly(['until', 'reason', 'permanent', 'hide', 'by', 'at', 'name', 'uname'])
        && request.resource.data.until is timestamp && request.resource.data.until > request.time
        && isStr(request.resource.data.reason, 1, 300)
        && request.resource.data.permanent is bool && request.resource.data.hide is bool
        && isStr(request.resource.data.get('name', ''), 0, 60) && isStr(request.resource.data.get('uname', ''), 0, 30)
        && request.resource.data.by == me() && request.resource.data.at == request.time;
      // Kind-words filter: a 1-hour automatic timeout the app sets on your own account when you
      // try to get around it (only if you have no suspension yet; a moderator lifts or keeps it).
      allow create: if signedIn() && uid == me() && !exists(banPath(uid))
        && request.resource.data.keys().hasOnly(['until', 'reason', 'permanent', 'hide', 'by', 'at', 'name', 'uname'])
        && request.resource.data.by == 'auto' && request.resource.data.permanent == false && request.resource.data.hide == false
        && request.resource.data.until is timestamp && request.resource.data.until > request.time
        && request.resource.data.until <= request.time + duration.value(61, 'm')
        && isStr(request.resource.data.reason, 1, 300) && request.resource.data.at == request.time
        && isStr(request.resource.data.get('name', ''), 0, 60) && isStr(request.resource.data.get('uname', ''), 0, 30);
      allow delete: if isMod() && (isAdmin() || !exists(rolePath(uid)));
    }
    // Removed accounts whose content is hidden everywhere (public list, moderators write).
    match /watchlist/{uid} {
      allow read: if signedIn() && (uid == me() || isMod());
      allow create, update: if isMod() && uid != me() && (isAdmin() || !exists(rolePath(uid)))
        && request.resource.data.keys().hasOnly(['reason', 'by', 'at', 'until'])
        && isStr(request.resource.data.reason, 0, 200) && request.resource.data.until is timestamp
        && request.resource.data.by == me() && request.resource.data.at == request.time;
      allow delete: if isMod() && !isAI();
    }
    match /hiddenUsers/{uid} {
      allow read: if true;
      allow create, update: if isMod() && !isAI() && uid != me() && (isAdmin() || !exists(rolePath(uid)))
        && request.resource.data.keys().hasOnly(['by', 'at']) && request.resource.data.by == me() && request.resource.data.at == request.time;
      allow delete: if isMod();
    }
    // ---------- Mod Hub ----------
    // Held posts: auto-flagged posts never go into posts/ until a moderator restores them, so nobody
    // else can read them. Readable by the author ("being reviewed") and moderators.
    match /heldPosts/{pid} {
      function hp() { return request.resource.data; }
      function livePost() { return /databases/$(database)/documents/posts/$(pid); }
      allow read: if signedIn() && (resource.data.authorId == me() || isMod());
      allow create: if signedIn() && notBanned()
        && hp().keys().hasOnly(['post', 'reason', 'level', 'authorId', 'createdAt', 'by'])
        && hp().post is map && hp().authorId == hp().post.authorId
        && isStr(hp().reason, 1, 200) && hp().level in ['bad', 'borderline', 'mod']
        && hp().createdAt == request.time
        && ((hp().level != 'mod' && !('by' in hp()) && actingAs(hp().authorId) && validNewPost(hp().post) && canCreate(hp().authorId))
            // a moderator pulls a live post into review
            || (hp().level == 'mod' && isMod() && hp().by == me() && exists(livePost())
                && hp().post == get(livePost()).data && !existsAfter(livePost())));
      allow delete: if signedIn() && (isMod() || resource.data.authorId == me());
    }
    // Bug reports & feedback from anyone signed in; moderators triage them.
    match /feedback/{id} {
      function fb() { return request.resource.data; }
      allow read: if signedIn() && (resource.data.uid == me() || isMod());
      allow create: if signedIn() && fb().keys().hasOnly(['uid', 'name', 'kind', 'text', 'page', 'ua', 'status', 'note', 'createdAt'])
        && fb().uid == me() && isStr(fb().name, 0, 60) && fb().kind in ['bug', 'feedback', 'idea']
        && cleanStr(fb().text, 1, 1500) && isStr(fb().page, 0, 200) && isStr(fb().ua, 0, 300)
        && fb().status == 'new' && fb().note == '' && fb().createdAt == request.time;
      allow update: if isMod() && changed().hasOnly(['status', 'note', 'handledBy', 'handledAt'])
        && fb().status in ['new', 'progress', 'fixed', 'closed'] && isStr(fb().note, 0, 1000)
        && fb().handledBy == me() && fb().handledAt == request.time;
      allow delete: if isAdmin();
    }
    // Two-way "Kemy Moderators" thread per user: modThreads/{uid} + /m/{mid}. The user reads/writes
    // only their own (suspended users too, so they can appeal); moderators read and write all.
    match /modThreads/{uid} {
      function th() { return request.resource.data; }
      function thShape() {
        return th().keys().hasOnly(['uid', 'name', 'uname', 'lastAt', 'lastText', 'lastFrom', 'unreadUser', 'unreadMod', 'ref'])
          && th().uid == uid && isStr(th().name, 0, 60) && isStr(th().uname, 0, 30) && th().lastAt == request.time
          && isStr(th().lastText, 0, 200) && th().unreadUser is bool && th().unreadMod is bool && isStr(th().ref, 0, 120);
      }
      allow read: if signedIn() && (uid == me() || isMod());
      allow create, update: if signedIn() && thShape() && (
        (isMod() && th().lastFrom == 'mod')
        || (uid == me() && th().lastFrom == 'user' && th().unreadMod == true && th().unreadUser == false && exists(/databases/$(database)/documents/modThreads/$(uid))));
      // marking read (no new message)
      allow update: if signedIn() && changed().hasOnly(['unreadUser', 'unreadMod'])
        && ((uid == me() && th().unreadUser == false && th().unreadMod == resource.data.unreadMod)
            || (isMod() && th().unreadMod == false && th().unreadUser == resource.data.unreadUser));
      match /m/{mid} {
        function mm() { return request.resource.data; }
        allow read: if signedIn() && (uid == me() || isMod());
        allow create: if signedIn() && mm().keys().hasOnly(['from', 'by', 'byName', 'text', 'createdAt', 'ref'])
          && mm().by == me() && isStr(mm().byName, 0, 60) && cleanStr(mm().text, 1, 1000) && isStr(mm().ref, 0, 120)
          && mm().createdAt == request.time
          && ((mm().from == 'mod' && isMod()) || (mm().from == 'user' && uid == me()))
          && getAfter(/databases/$(database)/documents/modThreads/$(uid)).data.lastAt == request.time;
      }
    }
    // Mod team notes / handoff board.
    match /modNotes/{id} {
      allow read: if isMod();
      allow create: if isMod() && request.resource.data.keys().hasOnly(['by', 'byName', 'text', 'done', 'createdAt'])
        && request.resource.data.by == me() && isStr(request.resource.data.byName, 0, 60)
        && cleanStr(request.resource.data.text, 1, 1000) && request.resource.data.done == false && request.resource.data.createdAt == request.time;
      allow update: if isMod() && changed().hasOnly(['done']) && request.resource.data.done is bool;
      allow delete: if isAdmin() || (isMod() && resource.data.by == me());
    }
    // Audit log of moderator actions: append-only. Moderators read it for user history; the full log tab is admin-only in the app.
    match /modLog/{id} {
      allow read: if isMod() && !isAI();
      allow create: if isMod()
        && request.resource.data.keys().hasOnly(['by', 'byName', 'action', 'targetUid', 'targetName', 'reportId', 'detail', 'at'])
        && request.resource.data.by == me() && isStr(request.resource.data.byName, 0, 60)
        && isStr(request.resource.data.action, 1, 40) && isStr(request.resource.data.targetUid, 0, 128)
        && isStr(request.resource.data.targetName, 0, 60) && isStr(request.resource.data.reportId, 0, 100)
        && isStr(request.resource.data.detail, 0, 400) && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
      // Kemy's Bubble Quest: one best-score doc per user per level (fastest time leaderboard).
    match /kqLevels/{lvl}/scores/{uid} {
      function kq() { return request.resource.data; }
      function kqValid() {
        return signedIn() && uid == me() && lvl.matches('^[1-3]-[1-2]$')
          && kq().keys().hasOnly(['uid', 'level', 'name', 'uname', 'time', 'stars', 'big', 'updatedAt'])
          && kq().uid == uid && kq().level == lvl && isStr(kq().name, 1, 40) && isStr(kq().uname, 0, 30)
          && kq().time is int && kq().time >= 10000 && kq().time <= 3600000
          && kq().stars is int && kq().stars >= 0 && kq().stars <= 80
          && kq().big is int && kq().big >= 0 && kq().big <= 3
          && kq().updatedAt == request.time;
      }
      allow read: if true;
      allow create: if kqValid();
      allow update: if kqValid() && kq().time <= resource.data.time && kq().stars >= resource.data.stars && kq().big >= resource.data.big;
      allow delete: if signedIn() && uid == me();
    }
      // Kemy Pals: up to 6 virtual pets per user (ids p1..p6), owner-written; visitors add one pat a day.
    match /users/{uid}/pets/{pid} {
      function pd() { return request.resource.data; }
      function hex(v) { return v is string && v.matches('^#[0-9a-fA-F]{6}$'); }
      function stat(v) { return v is int && v >= 0 && v <= 100; }
      function palValid() {
        return pd().keys().hasOnly(['species', 'name', 'colors', 'pattern', 'acc', 'xp', 'level', 'pats', 'stats', 'at', 'createdAt', 'updatedAt', 'outfit', 'voice', 'bg', 'variant'])
          && (!('variant' in pd()) || pd().variant == '' || (pd().variant is string && pd().variant.matches('^rare_[a-z]{2,11}$') && exists(/databases/$(database)/documents/users/$(uid)/inv/$(pd().variant))))
          && (!('bg' in pd()) || (pd().bg is string && (pd().bg.matches('^b_[a-z0-9_]{1,13}$')
               || (pd().bg.matches('^bp_[a-z0-9_]{1,13}$') && exists(/databases/$(database)/documents/users/$(uid)/inv/$(pd().bg))))))
          && (!('voice' in pd()) || (pd().voice is string && pd().voice.matches('^[a-z_]{2,16}$') && (!pd().voice.matches('^vx_.*') || exists(/databases/$(database)/documents/users/$(uid)/inv/$(pd().voice)))))
          && (!('outfit' in pd()) || outfitOk(pd().outfit))
          && pd().species is string && pd().species.matches('^[a-z]{2,16}$')
          && (pd().species != 'founder' || isAdmin())
          && (!pd().species.matches('^rx[a-z]+$') || exists(/databases/$(database)/documents/users/$(uid)/inv/$('sp_' + pd().species)))
          && isStr(pd().name, 1, 20)
          && pd().colors is map && pd().colors.keys().hasOnly(['body', 'accent', 'eye']) && hex(pd().colors.body) && hex(pd().colors.accent) && hex(pd().colors.eye)
          && (pd().pattern in ['none', 'spots', 'stripes', 'sparkle'] || (pd().pattern is string && pd().pattern.matches('^pt_[a-z]{2,13}$') && exists(/databases/$(database)/documents/users/$(uid)/inv/$(pd().pattern))))
          && pd().acc in ['none', 'bow', 'crown', 'shades', 'scarf', 'hat', 'badge']
          && pd().xp is int && pd().xp >= 0 && pd().xp <= 4900
          && pd().level == math.floor(pd().xp / 100) + 1
          && pd().pats is int
          && pd().stats is map && pd().stats.keys().hasOnly(['happy', 'hunger', 'energy', 'clean'])
          && stat(pd().stats.happy) && stat(pd().stats.hunger) && stat(pd().stats.energy) && stat(pd().stats.clean)
          && pd().at == request.time && pd().updatedAt == request.time;
      }
      function owns(o, k) {
        return o.get(k, '') == '' || (o.get(k, '') is string && o.get(k, '').matches('^f_[a-z0-9_]{1,13}$'))
          || (resource != null && 'outfit' in resource.data && resource.data.outfit.get(k, '') == o.get(k, ''))
          || exists(/databases/$(database)/documents/users/$(uid)/inv/$(o.get(k, '')));
      }
      function outfitOk(o) {
        return o is map && o.keys().hasOnly(['head', 'face', 'neck', 'body', 'feet', 'back', 'hair', 'bottom', 'full', 'bag', 'held', 'ears', 'wrist', 'hand', 'nose'])
          && owns(o, 'head') && owns(o, 'face') && owns(o, 'neck') && owns(o, 'body') && owns(o, 'feet') && owns(o, 'back')
          && owns(o, 'hair') && owns(o, 'bottom') && owns(o, 'full') && owns(o, 'bag') && owns(o, 'held')
          && owns(o, 'ears') && owns(o, 'wrist') && owns(o, 'hand') && owns(o, 'nose');
      }
      function patPath() { return /databases/$(database)/documents/users/$(uid)/pets/$(pid)/pats/$(me()); }
      allow read: if true;
      allow create: if signedIn() && uid == me() && pid.matches('^p[1-6]$') && palValid()
        && pd().xp == 0 && pd().pats == 0 && pd().createdAt == request.time;
      allow update: if signedIn() && uid == me() && palValid()
        && pd().createdAt == resource.data.createdAt && pd().pats == resource.data.pats
        && pd().xp >= resource.data.xp && pd().xp <= resource.data.xp + 60
        && resource.data.updatedAt + duration.value(1, 's') < request.time;
      // a visitor's pat: +1 on the counter, only together with a fresh pat doc (once per 20 hours)
      allow update: if signedIn() && uid != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pats'])
        && pd().pats == resource.data.pats + 1
        && getAfter(patPath()).data.at == request.time
        && (!exists(patPath()) || get(patPath()).data.at + duration.value(20, 'h') < request.time);
      allow delete: if signedIn() && uid == me();
      match /pats/{vid} {
        function petPath() { return /databases/$(database)/documents/users/$(uid)/pets/$(pid); }
        allow read: if true;
        allow create, update: if signedIn() && vid == me() && uid != me()
          && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == vid
          && request.resource.data.at == request.time
          && (resource == null || resource.data.at + duration.value(20, 'h') < request.time)
          && getAfter(petPath()).data.pats == get(petPath()).data.pats + 1;
        allow delete: if signedIn() && (vid == me() || uid == me());
      }
      // play dates: a visitor's Pal plays with this Pal, once per visitor per 20 hours
      match /playdates/{vid} {
        allow read: if true;
        allow create, update: if signedIn() && vid == me() && uid != me()
          && request.resource.data.keys().hasOnly(['uid', 'pet', 'at']) && request.resource.data.uid == vid
          && request.resource.data.pet is string && request.resource.data.pet.matches('^p[1-6]$')
          && exists(/databases/$(database)/documents/users/$(vid)/pets/$(request.resource.data.pet))
          && request.resource.data.at == request.time
          && (resource == null || resource.data.at + duration.value(20, 'h') < request.time);
        allow delete: if signedIn() && (vid == me() || uid == me());
      }
    }

    // ================= Kemy Pals economy: Star Coins, inventory, outfits (Spark-friendly, no functions)
    // Price catalog: only the admin writes it. Every purchase is checked against it.
    // Support Kemy donation links: public read, admin-only write, https links only.
    match /config/donate {
      function okLink(k) { return !(k in request.resource.data) || request.resource.data[k] == '' || (request.resource.data[k] is string && request.resource.data[k].size() <= 300 && request.resource.data[k].matches('https://[^\\s]+')); }
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['kofi', 'cashapp', 'paypal', 'bmac', 'other', 'otherLabel', 'updatedAt'])
        && okLink('kofi') && okLink('cashapp') && okLink('paypal') && okLink('bmac') && okLink('other')
        && (!('otherLabel' in request.resource.data) || isStr(request.resource.data.otherLabel, 0, 30));
    }
    // New-account video check: how many live posts before videos skip review (admin only).
    match /config/mediaReview {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['minApproved', 'updatedAt'])
        && request.resource.data.minApproved is int && request.resource.data.minApproved >= 0 && request.resource.data.minApproved <= 50;
    }
    match /config/palShop {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid}/pal/wallet {
      function w() { return request.resource.data; }
      function ow() { return resource.data; }
      function dayNow() { return int(request.time.toMillis() / 86400000); }
      // Star Coin sources: max per write and max per day
      function emax() { return { 'daily': 50, 'care': 5, 'win': 25, 'quest': 10, 'stars': 5, 'park': 10, 'chat': 2 }; }
      function ecap() { return { 'daily': 50, 'care': 60, 'win': 150, 'quest': 60, 'stars': 50, 'park': 100, 'chat': 20 }; }
      function invPath(i) { return /databases/$(database)/documents/users/$(uid)/inv/$(i); }
      function shop() { return get(/databases/$(database)/documents/config/palShop).data; }
      function walletShape() {
        return w().keys().hasOnly(['coins', 'total', 'day', 'earned', 'src', 'last', 'lastBuy', 'paid', 'buyAt', 'room', 'updatedAt'])
          && w().coins is int && w().coins >= 0 && w().total is int && w().day is int && w().earned is map
          && w().room is list && w().room.size() <= 3 && w().updatedAt == request.time;
      }
      function amt() { return w().coins - ow().coins; }
      function earnOk() {
        return w().src in emax() && amt() > 0 && amt() <= emax()[w().src]
          && w().total == ow().total + amt() && w().day == dayNow() && w().last == request.time
          && ow().last + duration.value(1, 's') < request.time
          && ((ow().day == dayNow() && w().earned.diff(ow().earned).affectedKeys().hasOnly([w().src])
               && w().earned[w().src] == ow().earned.get(w().src, 0) + amt())
              || (ow().day != dayNow() && w().earned.keys().hasOnly([w().src]) && w().earned[w().src] == amt()))
          && w().earned[w().src] <= ecap()[w().src];
      }
      function buyOk() {
        return w().paid == ow().coins - w().coins && w().paid > 0 && w().buyAt == request.time
          && w().lastBuy in shop().prices
          && (w().paid == shop().prices[w().lastBuy] || w().paid == shop().deals[dayNow() % shop().deals.size()].get(w().lastBuy, -1))
          && getAfter(invPath(w().lastBuy)).data.at == request.time;
      }
      function adminBuyOk() {
        return w().paid == 0 && w().buyAt == request.time && w().lastBuy in shop().prices
          && getAfter(invPath(w().lastBuy)).data.at == request.time;
      }
      function roomOk() {
        return (w().room.size() < 1 || exists(invPath(w().room[0]))) && (w().room.size() < 2 || exists(invPath(w().room[1])))
          && (w().room.size() < 3 || exists(invPath(w().room[2])));
      }
      allow read: if true;
      allow create: if signedIn() && uid == me() && walletShape() && w().coins == 0 && w().total == 0 && w().day == dayNow()
        && w().earned.size() == 0 && w().room.size() == 0 && w().last == request.time && w().paid == 0 && w().lastBuy == '';
      allow update: if signedIn() && uid == me() && walletShape() && (
        (changed().hasOnly(['coins', 'total', 'day', 'earned', 'src', 'last', 'updatedAt']) && earnOk())
        || (changed().hasOnly(['coins', 'lastBuy', 'paid', 'buyAt', 'updatedAt']) && buyOk())
        // owner/admin or ∞ Pass: unlimited Star Coins - records a valid shop purchase (paid 0) without touching the balance
        || (unlimitedFor(uid) && changed().hasOnly(['lastBuy', 'paid', 'buyAt', 'updatedAt']) && adminBuyOk())
        || (changed().hasOnly(['room', 'updatedAt']) && roomOk()));
      allow delete: if signedIn() && uid == me();
    }
    // Diamonds (Pal Zombie Survival currency): earned once per finished run (max 250 per run, 1500 per day,
    // one run reward every 45 s), spent only on config/palShop.dprices items (inv doc written in the same batch).
    match /users/{uid}/pal/diamonds {
      function d() { return request.resource.data; }
      function od() { return resource.data; }
      function dDay() { return int(request.time.toMillis() / 86400000); }
      function dShop() { return get(/databases/$(database)/documents/config/palShop).data; }
      function dShape() {
        return d().keys().hasOnly(['d', 'total', 'day', 'today', 'last', 'lastBuy', 'paid', 'buyAt', 'updatedAt'])
          && d().d is int && d().d >= 0 && d().total is int && d().day is int && d().today is int && d().paid is int
          && d().lastBuy is string && d().updatedAt == request.time;
      }
      function dAmt() { return d().d - od().d; }
      function dEarnOk() {
        return dAmt() > 0 && dAmt() <= 250 && d().total == od().total + dAmt() && d().day == dDay() && d().last == request.time
          && od().last + duration.value(45, 's') < request.time
          && d().today == (od().day == dDay() ? od().today : 0) + dAmt() && d().today <= 1500;
      }
      function dBuyOk() {
        return d().paid == od().d - d().d && d().paid > 0 && d().buyAt == request.time
          && d().lastBuy in dShop().get('dprices', {}) && d().paid == dShop().dprices[d().lastBuy]
          && getAfter(/databases/$(database)/documents/users/$(uid)/inv/$(d().lastBuy)).data.at == request.time;
      }
      allow read: if true;
      allow create: if signedIn() && uid == me() && dShape() && d().d == 0 && d().total == 0 && d().today == 0 && d().paid == 0
        && d().lastBuy == '' && d().last == request.time && d().day == dDay();
      allow update: if signedIn() && uid == me() && dShape() && (
        (changed().hasOnly(['d', 'total', 'day', 'today', 'last', 'updatedAt']) && dEarnOk())
        || (changed().hasOnly(['d', 'lastBuy', 'paid', 'buyAt', 'updatedAt']) && dBuyOk())
        // owner/admin or ∞ Pass: unlimited Diamonds - records a valid Diamond purchase (paid 0) without touching the balance
        || (unlimitedFor(uid) && changed().hasOnly(['lastBuy', 'paid', 'buyAt', 'updatedAt']) && d().paid == 0 && d().buyAt == request.time
            && d().lastBuy in dShop().get('dprices', {})
            && getAfter(/databases/$(database)/documents/users/$(uid)/inv/$(d().lastBuy)).data.at == request.time));
      allow delete: if signedIn() && uid == me();
    }
    // ================= Pal Zombie Survival co-op lobbies (2-4 players)
    // Lobby doc: host only (plus a guarded take-over when the host has been quiet for 8 s or left).
    // Seats: one create-only doc per seat (max 4). Player docs: only their owner. Game state: only the host.
    match /zLobbies/{code} {
      function zl() { return request.resource.data; }
      function zlp(u) { return /databases/$(database)/documents/zLobbies/$(code)/p/$(u); }
      function zlPath() { return /databases/$(database)/documents/zLobbies/$(code); }
      function zlShape() {
        return zl().keys().hasOnly(['host', 'status', 'pub', 'n', 'wave', 'createdAt', 'updatedAt'])
          && zl().host is string && zl().host.size() <= 128 && zl().status in ['open', 'playing', 'done'] && zl().pub is bool
          && zl().n is int && zl().n >= 0 && zl().n <= 4 && zl().wave is int && zl().wave >= 0 && zl().wave <= 1000 && zl().updatedAt == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && code.matches('^[A-Z2-9]{5}$') && zlShape() && zl().host == me() && zl().status == 'open' && zl().n == 1 && zl().createdAt == request.time;
      allow update: if signedIn() && zlShape() && zl().createdAt == resource.data.createdAt && (
        (resource.data.host == me() && (zl().host == me() || exists(zlp(zl().host))))
        || (zl().host == me() && resource.data.host != me() && exists(zlp(me()))
            && (!exists(zlp(resource.data.host)) || get(zlp(resource.data.host)).data.at < request.time - duration.value(8, 's'))
            && zl().diff(resource.data).affectedKeys().hasOnly(['host', 'updatedAt'])));
      allow delete: if signedIn() && (resource.data.host == me() || resource.data.updatedAt < request.time - duration.value(30, 'm'));
      match /slot/{s} {
        allow read: if signedIn();
        allow create: if signedIn() && notBanned() && s in ['0', '1', '2', '3'] && exists(zlPath())
          && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == me() && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || !exists(zlPath()) || get(zlPath()).data.host == me()
          || resource.data.at < request.time - duration.value(30, 'm'));
      }
      match /p/{u} {
        function zp() { return request.resource.data; }
        function zpShape() {
          return zp().keys().hasOnly(['name', 'pal', 'slot', 'ready', 'x', 'y', 'z', 'f', 'a', 'fire', 'w', 'hp', 'down', 'rev', 'em', 'emAt', 'hits', 'hs', 'at'])
            && isStr(zp().name, 0, 40) && zp().pal is map && zp().pal.size() <= 8 && zp().pal.get('outfit', {}) is map && zp().pal.get('outfit', {}).size() <= 15
            && zp().pal.get('colors', {}) is map && zp().pal.get('colors', {}).size() <= 4
            && zp().slot is int && zp().slot >= 0 && zp().slot <= 3 && zp().ready is bool
            && zp().x is number && zp().y is number && zp().z is number && zp().f is number && zp().a is number
            && zp().x >= -60 && zp().x <= 60 && zp().z >= -60 && zp().z <= 60 && zp().y >= -5 && zp().y <= 20
            && zp().fire is bool && isStr(zp().w, 0, 10) && zp().hp is number && zp().hp >= 0 && zp().hp <= 200 && zp().down is bool
            && isStr(zp().rev, 0, 128) && zp().em is int && zp().em >= -1 && zp().em <= 999 && zp().emAt is int
            && zp().hits is list && zp().hits.size() <= 45 && zp().hs is int && zp().at == request.time;
        }
        allow read: if signedIn();
        allow create, update: if signedIn() && u == me() && zpShape()
          && getAfter(/databases/$(database)/documents/zLobbies/$(code)/slot/$(string(zp().slot))).data.uid == me()
          && (resource == null || resource.data.at + duration.value(60, 'ms') < request.time);
        allow delete: if signedIn() && (u == me() || !exists(zlPath()) || get(zlPath()).data.host == me() || resource.data.at < request.time - duration.value(30, 'm'));
      }
      match /s/{d} {
        function zs() { return request.resource.data; }
        allow read: if signedIn();
        allow create, update: if signedIn() && d == 'state' && get(zlPath()).data.host == me()
          && zs().keys().hasOnly(['wave', 'zs', 'score', 'kills', 'dia', 'over', 'slam', 'seq', 'n', 'ts', 'brk', 'bm', 'at'])
          && zs().wave is int && zs().wave >= 0 && zs().wave <= 1000 && zs().zs is list && zs().zs.size() <= 300
          && zs().score is int && zs().kills is map && zs().kills.size() <= 4 && zs().dia is map && zs().dia.size() <= 4
          && zs().over is bool && zs().slam is list && zs().slam.size() <= 4 && zs().seq is int && zs().n is int && zs().n >= 1 && zs().n <= 4
          && zs().at == request.time;
        allow delete: if signedIn() && (!exists(zlPath()) || get(zlPath()).data.host == me() || resource.data.at < request.time - duration.value(30, 'm'));
      }
    }
    // Kemy Challenge Show (js/pals/show-net.js): up to 30 players per room, host-authoritative show state
    match /shows/{code} {
      function sl() { return request.resource.data; }
      function shp(u) { return /databases/$(database)/documents/shows/$(code)/p/$(u); }
      function shPath() { return /databases/$(database)/documents/shows/$(code); }
      function slShape() {
        return sl().keys().hasOnly(['host', 'status', 'pub', 'n', 'createdAt', 'updatedAt'])
          && sl().host is string && sl().host.size() <= 128 && sl().status in ['open', 'playing', 'done'] && sl().pub is bool
          && sl().n is int && sl().n >= 0 && sl().n <= 30 && sl().updatedAt == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && code.matches('^[A-Z2-9]{5}$') && slShape() && sl().host == me() && sl().status == 'open' && sl().n == 1 && sl().createdAt == request.time;
      allow update: if signedIn() && notBanned() && slShape() && sl().createdAt == resource.data.createdAt && (
        (resource.data.host == me() && (sl().host == me() || exists(shp(sl().host))))
        || (sl().host == me() && resource.data.host != me() && exists(shp(me()))
            && (!exists(shp(resource.data.host)) || get(shp(resource.data.host)).data.at < request.time - duration.value(8, 's'))
            && sl().diff(resource.data).affectedKeys().hasOnly(['host', 'updatedAt'])));
      allow delete: if signedIn() && (resource.data.host == me() || resource.data.updatedAt < request.time - duration.value(30, 'm'));
      match /slot/{s} {
        allow read: if signedIn();
        allow create: if signedIn() && notBanned() && s.matches('^([0-9]|[12][0-9])$') && exists(shPath())
          && request.resource.data.keys().hasOnly(['uid', 'at']) && request.resource.data.uid == me() && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || !exists(shPath()) || get(shPath()).data.host == me()
          || resource.data.at < request.time - duration.value(30, 'm'));
      }
      match /p/{u} {
        function sp() { return request.resource.data; }
        function spShape() {
          return sp().keys().hasOnly(['name', 'pal', 'slot', 'ready', 'x', 'y', 'z', 'f', 'v', 'st', 'r', 'sc', 'tp', 'bp', 'em', 'emAt', 'at'])
            && isStr(sp().name, 0, 40) && sp().pal is map && sp().pal.size() <= 8 && sp().pal.get('outfit', {}) is map && sp().pal.get('outfit', {}).size() <= 15
            && sp().pal.get('colors', {}) is map && sp().pal.get('colors', {}).size() <= 4
            && sp().slot is int && sp().slot >= 0 && sp().slot <= 29 && sp().ready is bool
            && sp().x is number && sp().y is number && sp().z is number && sp().f is number && sp().v is number
            && sp().x >= -120 && sp().x <= 120 && sp().z >= -120 && sp().z <= 120 && sp().y >= -20 && sp().y <= 40 && sp().v >= 0 && sp().v <= 50
            && sp().st is int && sp().st >= 0 && sp().st <= 2 && sp().r is int && sp().r >= -1 && sp().r <= 10
            && sp().sc is int && sp().sc >= -10 && sp().sc <= 10000 && sp().tp is int && sp().tp >= 0 && sp().tp <= 5000
            && sp().bp is list && sp().bp.size() <= 24 && sp().em is int && sp().em >= -1 && sp().em <= 999 && sp().emAt is int && sp().at == request.time;
        }
        allow read: if signedIn();
        allow create, update: if signedIn() && notBanned() && u == me() && spShape()
          && getAfter(/databases/$(database)/documents/shows/$(code)/slot/$(string(sp().slot))).data.uid == me()
          && (resource == null || resource.data.at + duration.value(250, 'ms') < request.time);
        allow delete: if signedIn() && (u == me() || !exists(shPath()) || get(shPath()).data.host == me() || resource.data.at < request.time - duration.value(30, 'm'));
      }
      match /s/{d} {
        function ss() { return request.resource.data; }
        allow read: if signedIn();
        allow create, update: if signedIn() && d == 'state' && get(shPath()).data.host == me()
          && ss().keys().hasOnly(['ph', 'rd', 'nx', 'plan', 'left', 'light', 'lq', 'll', 'alive', 'out', 'elim', 'teams', 'pairs', 'rope', 'seed', 'rev', 'nb', 'bots', 'bb', 'bbq', 'champ', 'casual', 'seq', 'at'])
          && ss().ph in ['wait', 'intro', 'play', 'inter', 'end'] && ss().rd is int && ss().rd >= 0 && ss().rd <= 10
          && ss().get('plan', []) is list && ss().get('plan', []).size() <= 8 && ss().get('alive', []) is list && ss().get('alive', []).size() <= 45
          && ss().get('out', []) is list && ss().get('out', []).size() <= 45 && ss().get('elim', {}) is map && ss().get('elim', {}).size() <= 45
          && ss().get('teams', []) is list && ss().get('teams', []).size() <= 45 && ss().get('pairs', []) is list && ss().get('pairs', []).size() <= 45
          && ss().get('rev', []) is list && ss().get('rev', []).size() <= 16 && ss().get('bots', []) is list && ss().get('bots', []).size() <= 75
          && ss().get('bb', []) is list && ss().get('bb', []).size() <= 24 && ss().get('champ', []) is list && ss().get('champ', []).size() <= 45
          && ss().get('nb', 0) is int && ss().get('nb', 0) <= 14 && ss().seq is int && ss().at == request.time;
        allow delete: if signedIn() && (!exists(shPath()) || get(shPath()).data.host == me() || resource.data.at < request.time - duration.value(30, 'm'));
      }
    }
    // Talk to your Pal: short chat memory (last messages + a few facts), owner-only
    match /users/{uid}/pal/chat {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['msgs', 'facts', 'updatedAt'])
        && request.resource.data.msgs is list && request.resource.data.msgs.size() <= 12
        && request.resource.data.facts is list && request.resource.data.facts.size() <= 6
        && request.resource.data.updatedAt == request.time;
    }
    // owner's Pal settings that visitors may read (e.g. 'let visitors chat with my Pal')
    // Parental Controls PIN: only a salted SHA-256 hash, readable/writable by the account owner only.
    match /parental/{uid} {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['salt', 'hash', 'updatedAt'])
        && request.resource.data.salt is string && request.resource.data.salt.matches('^[0-9a-f]{32}$')
        && request.resource.data.hash is string && request.resource.data.hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/pal/settings {
      allow read: if true;
      allow write: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['visitorChat', 'updatedAt'])
        && request.resource.data.visitorChat is bool && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && uid == me();
    }
    match /users/{uid}/inv/{item} {
      function v() { return request.resource.data; }
      function walletPath() { return /databases/$(database)/documents/users/$(uid)/pal/wallet; }
      function oldN() { return resource == null ? 0 : resource.data.n; }
      function kind() { return get(/databases/$(database)/documents/config/palShop).data.kinds[item]; }
      function bought() { return getAfter(walletPath()).data.buyAt == request.time && getAfter(walletPath()).data.lastBuy == item; }
      function dPath() { return /databases/$(database)/documents/users/$(uid)/pal/diamonds; }
      function dBought() { return getAfter(dPath()).data.buyAt == request.time && getAfter(dPath()).data.lastBuy == item; }
      function achOk() {
        return oldN() == 0 && v().n == 1 && (
          (item == 'ach_glow' && v().proof is string && v().proof.matches('^p[1-6]$')
             && get(/databases/$(database)/documents/users/$(uid)/pets/$(v().proof)).data.level >= 12)
          || (item == 'ach_coins' && get(walletPath()).data.total >= 1000)
          || (item == 'ach_family' && v().proof is list && v().proof.size() == 3 && v().proof[0] != v().proof[1] && v().proof[1] != v().proof[2] && v().proof[0] != v().proof[2]
             && exists(/databases/$(database)/documents/users/$(uid)/pets/$(v().proof[0]))
             && exists(/databases/$(database)/documents/users/$(uid)/pets/$(v().proof[1]))
             && exists(/databases/$(database)/documents/users/$(uid)/pets/$(v().proof[2])))
          || (item == 'ach_champ' && get(/databases/$(database)/documents/palStats/$(uid)).data.wins >= 5));
      }
      allow read: if true;
      allow create, update: if signedIn() && uid == me() && item.matches('^[a-z_]{2,16}$')
        && v().keys().hasOnly(['n', 'at', 'proof']) && v().n is int && v().at == request.time && (
          // bought: +1 together with the wallet purchase (wearables, decor and toys are one each)
          (v().n == oldN() + 1 && bought() && (kind() == 'snack' || v().n == 1))
          // bought with Diamonds (Zombie Armory, one each)
          || (v().n == 1 && oldN() == 0 && item.matches('^z_[a-z_]+$') && dBought())
          // used up a snack or toy
          || (resource != null && v().n == oldN() - 1 && v().n >= 0)
          // achievement reward, checked against real progress
          || (item.matches('^ach_[a-z]+$') && achOk()));
      allow delete: if signedIn() && uid == me();
    }
    match /users/{uid}/looks/{lid} {
      allow read: if true;
      allow write: if signedIn() && uid == me() && lid.matches('^l[1-6]$')
        && request.resource.data.keys().hasOnly(['name', 'outfit', 'bg', 'variant', 'pattern', 'colors', 'at']) && isStr(request.resource.data.name, 1, 20)
        && request.resource.data.outfit is map && request.resource.data.outfit.size() <= 15
        && request.resource.data.outfit.keys().hasOnly(['head', 'face', 'neck', 'body', 'feet', 'back', 'hair', 'bottom', 'full', 'bag', 'held', 'ears', 'wrist', 'hand', 'nose'])
        && (!('bg' in request.resource.data) || isStr(request.resource.data.bg, 0, 16))
        && (!('variant' in request.resource.data) || isStr(request.resource.data.variant, 0, 16))
        && (!('pattern' in request.resource.data) || isStr(request.resource.data.pattern, 0, 16))
        && (!('colors' in request.resource.data) || (request.resource.data.colors is map && request.resource.data.colors.size() <= 3));
      allow delete: if signedIn() && uid == me();
    }

    // ================= Pal Games (real-time Pal vs Pal mini-games)
    match /palGames/{gid} {
      function g() { return request.resource.data; }
      function og() { return resource.data; }
      allow read: if true;
      allow create: if signedIn() && notBanned() && g().keys().hasOnly(['game', 'status', 'players', 'names', 'unames', 'pals', 'host', 'invitee', 'quick', 'seed', 'startAt', 'createdAt', 'updatedAt'])
        && g().game in ['race', 'bubbles', 'stars', 'dance'] && g().status == 'waiting' && g().host == me()
        && g().players == [me()] && g().names is list && g().names.size() == 1 && g().unames is list && g().unames.size() == 1
        && g().pals is list && g().pals.size() == 1 && isStr(g().invitee, 0, 128) && g().quick is bool && g().seed is int
        && g().createdAt == request.time && g().updatedAt == request.time;
      allow update: if signedIn() && (
        // join: second seat, starts the countdown
        (og().status == 'waiting' && !(me() in og().players) && og().invitee in ['', me()] && og().players.size() == 1
          && changed().hasOnly(['players', 'names', 'unames', 'pals', 'status', 'startAt', 'updatedAt'])
          && g().players == og().players.concat([me()]) && g().names.size() == 2 && g().unames.size() == 2 && g().pals.size() == 2
          && g().status == 'active' && g().startAt is timestamp && g().startAt > request.time && g().startAt < request.time + duration.value(10, 's')
          && g().updatedAt == request.time)
        // finish / cancel
        || (me() in og().players && changed().hasOnly(['status', 'updatedAt']) && g().status == 'done'));
      allow delete: if isAdmin();
      // each player's live progress (throttled ~2/s) and final score
      match /live/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && uid == me() && me() in get(/databases/$(database)/documents/palGames/$(gid)).data.players
          && request.resource.data.keys().hasOnly(['p', 's', 'fin', 'at', 'em', 'emAt']) && (!('em' in request.resource.data) || (request.resource.data.em is int && request.resource.data.em >= -1 && request.resource.data.em <= 199 && request.resource.data.emAt is int)) && request.resource.data.p is int && request.resource.data.p >= 0 && request.resource.data.p <= 1000
          && request.resource.data.s is int && request.resource.data.s >= 0 && request.resource.data.s <= 999 && request.resource.data.fin is bool
          && request.resource.data.at == request.time
          && (resource == null || (!resource.data.fin && resource.data.at + duration.value(300, 'ms') < request.time && request.resource.data.s >= resource.data.s));
        allow delete: if false;
      }
      match /rec/{uid} {
        allow read: if true;
        allow create: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/palStats/$(uid)).data.last == gid;
      }
    }
    // Pal Games leaderboard: wins only count for finished human matches where your score beat theirs.
    match /palStats/{uid} {
      function ps() { return request.resource.data; }
      function pg() { return get(/databases/$(database)/documents/palGames/$(ps().last)).data; }
      function other() { return pg().players[0] == uid ? pg().players[1] : pg().players[0]; }
      function lv(u) { return get(/databases/$(database)/documents/palGames/$(ps().last)/live/$(u)).data; }
      function fresh() {
        return !exists(/databases/$(database)/documents/palGames/$(ps().last)/rec/$(uid))
          && existsAfter(/databases/$(database)/documents/palGames/$(ps().last)/rec/$(uid));
      }
      function base() {
        return signedIn() && uid == me() && ps().keys().hasOnly(['wins', 'games', 'last', 'name', 'uname', 'color', 'updatedAt'])
          && isStr(ps().last, 1, 40) && pg().players.size() == 2 && uid in pg().players && lv(uid).fin && lv(other()).fin && fresh()
          && ps().updatedAt == request.time && ps().name == get(/databases/$(database)/documents/users/$(uid)).data.displayName
          && ps().uname == get(/databases/$(database)/documents/users/$(uid)).data.username && isStr(ps().color, 0, 20);
      }
      function won() { return lv(uid).s > lv(other()).s; }
      allow read: if true;
      allow create: if base() && ps().games == 1 && ps().wins == (won() ? 1 : 0);
      allow update: if base() && ps().games == resource.data.games + 1 && ps().wins == resource.data.wins + (won() ? 1 : 0);
      allow delete: if isAdmin() || (signedIn() && uid == me());
    }

    // ================= Kemy World property: one home per player (sale plots only), garage tier, private world save
    match /homes/{plot} {
      function hd() { return request.resource.data; }
      function plotNum() { return int(plot.replace('[hm]', '')); }
      // h01..h98: the original plots (fixed map); h99..h482: city plots (style = number % 4, only the For Sale half); h483..h488 estates; h489 = admin palace
      function citySale(n) { return n % 8 in [0, 3, 5, 6]; } // = layout.js city plots: half for sale, every style
      function plotStyle() { let n = plotNum(); return n <= 98 ? {'h02': 'manor', 'h05': 'cottage', 'h08': 'cottage', 'h11': 'twostory', 'h14': 'ranch', 'h17': 'twostory', 'h20': 'ranch', 'h23': 'manor', 'h26': 'cottage', 'h29': 'twostory', 'h32': 'ranch', 'h35': 'manor', 'h38': 'manor', 'h41': 'cottage', 'h44': 'twostory', 'h47': 'ranch', 'h50': 'manor', 'h53': 'cottage', 'h56': 'twostory', 'h59': 'ranch', 'h62': 'manor', 'h65': 'cottage', 'h68': 'twostory', 'h71': 'ranch', 'h74': 'manor', 'h77': 'cottage', 'h80': 'twostory', 'h83': 'ranch', 'h86': 'manor', 'h89': 'cottage', 'h92': 'twostory', 'h95': 'ranch', 'h98': 'manor'}[plot] : n <= 482 ? (citySale(n) ? ['cottage', 'twostory', 'ranch', 'manor'][n % 4] : null) : n >= 1000 ? ['cottage', 'twostory', 'ranch', 'manor'][n % 4]
        : {'h483': 'mansion', 'h484': 'estate', 'h485': 'mansion', 'h486': 'estate', 'h487': 'mansion', 'h488': 'estate'}[plot]; }
      function isEstate() { let n = plotNum(); return n >= 483 && n <= 489; } // hm1000..hm3591 = the far-south metro cities (all for sale, style = number % 4)
      function deed() { return {'cottage': 'hs_cottage', 'twostory': 'hs_twostory', 'ranch': 'hs_ranch', 'manor': 'z_hs_manor', 'mansion': 'z_hs_mansion', 'estate': 'z_hs_estate'}[plotStyle()]; }
      function inv(it) { return exists(/databases/$(database)/documents/users/$(me())/inv/$(it)); }
      // tier t needs that tier's item or any higher one (garage only changes when it differs, so plain saves cost no lookups)
      function gItem(t) { return ['gr_one', 'gr_two', 'z_gr_three', 'z_gr_four', 'z_gr_five', 'z_gr_six', 'z_gr_seven'][t - 1]; }
      function gHas(t) { return inv(gItem(t)) || (t < 7 && inv(gItem(t + 1))) || (t < 6 && inv(gItem(t + 2))); }
      function garageOk() { return hd().garage == 0 || (resource != null && hd().garage == resource.data.get('garage', 0)) || (hd().garage <= (isEstate() ? 7 : 5) && gHas(hd().garage)); }
      // parked cars (display only): 'model.colour[.PLATE.bg.fg.border.frame]' joined by ';', max 50 entries / 1800 chars
      function carsOk(c) { return c is string && c.size() <= 1800 && c.matches('^[a-z]{2,8}[.][0-9][A-Z0-9.;a-z]*$|^$') && c.split(';').size() <= 50; } // clients parse + re-check each entry (and the plate word filter)
      function radioOk(r) { return r is map && r.keys().hasOnly(['k', 'url', 't', 's']) && r.k in ['link', 'kemy', 'off']
        && (r.k != 'link' || (r.url is string && r.url.size() <= 300 && r.url.matches('^https://(open[.]spotify[.]com|embed[.]music[.]apple[.]com|music[.]apple[.]com)/.*')))
        && (!('t' in r) || (r.t is int && r.t >= 0 && r.t < 50)) && (!('s' in r) || r.s is int); }
      function extOk(e) { return e is map && e.keys().hasOnly(['w', 'r', 'd', 't']) && (!('w' in e) || isStr(e.w, 0, 9)) && (!('r' in e) || isStr(e.r, 0, 9)) && (!('d' in e) || isStr(e.d, 0, 9)) && (!('t' in e) || isStr(e.t, 0, 9)); }
      function decorOk(d) { return d is map && d.keys().hasOnly(['wall', 'walls', 'floor', 'ext', 'items', 'v']) && (!('wall' in d) || isStr(d.wall, 0, 9)) && (!('walls' in d) || isStr(d.walls, 0, 120)) && (!('floor' in d) || d.floor in ['wood', 'dark', 'tile', 'carpet', 'marble', 'mint', 'rose', 'night', 'gold'])
        && (!('items' in d) || isStr(d.items, 0, 2000)) && (!('ext' in d) || extOk(d.ext)) && (!('v' in d) || d.v is int); }
      // open house / invites (uids + usernames for display), house radio, decor: owner-only, size-limited
      function extrasOk() { return (!('open' in hd()) || hd().open is bool) && (!('inv' in hd()) || (hd().inv is list && hd().inv.size() <= 50)) && (!('invN' in hd()) || (hd().invN is list && hd().invN.size() <= 50))
        && (!('radio' in hd()) || radioOk(hd().radio)) && (!('decor' in hd()) || decorOk(hd().decor)) && (!('cars' in hd()) || carsOk(hd().cars)); }
      function shape() { return hd().keys().hasOnly(['owner', 'name', 'style', 'garage', 'at', 'open', 'inv', 'invN', 'radio', 'decor', 'cars']) && extrasOk() && hd().owner == me() && hd().garage is int && hd().garage >= 0 && hd().garage <= 7
        && hd().name == get(/databases/$(database)/documents/users/$(me())).data.displayName && hd().at == request.time; }
      allow read: if signedIn();
      // 👑 h489 = the admin's palace: never for sale, only the admin account can create / change / remove it
      allow create: if signedIn() && notBanned() && (plot.matches('^h[0-9]{2,3}$') && plotNum() <= 488 || plot.matches('^hm[0-9]{4}$') && plotNum() >= 1000 && plotNum() <= 3591) && plotStyle() != null && shape() && hd().style == plotStyle() && inv(deed()) && garageOk()
        && getAfter(/databases/$(database)/documents/users/$(me())/pal/home).data.plot == plot
        || plot == 'h489' && isAdmin() && shape() && hd().style == 'estate';
      allow update: if signedIn() && resource.data.owner == me() && shape() && hd().style == resource.data.style && (plot == 'h489' ? isAdmin() : garageOk());
      // owner moves out, or anyone may clear a home whose owner account no longer exists (it goes back on sale)
      allow delete: if signedIn() && (resource.data.owner == me() && (plot != 'h489' || isAdmin()) || plot != 'h489' && !exists(/databases/$(database)/documents/users/$(resource.data.owner)));
    }
    match /users/{uid}/pal/home {
      allow read: if signedIn() && uid == me();
      allow create: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['plot', 'at']) && request.resource.data.plot is string
        && request.resource.data.plot.matches('^h[0-9]{2,3}$|^hm[0-9]{4}$') && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/homes/$(request.resource.data.plot)).data.owner == me();
      allow delete: if signedIn() && uid == me();
    }
    match /users/{uid}/pal/drive {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['cfg', 'at']) && request.resource.data.cfg is string
        && request.resource.data.cfg.size() <= 4000 && request.resource.data.at == request.time;
    }
    match /users/{uid}/pal/world {
      function wd() { return request.resource.data; }
      function carOk(c) { return c is map && c.keys().hasOnly(['id', 'c', 'bay', 'x', 'z', 'yaw']) && c.id is string && c.id.size() <= 12; }
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me() && wd().keys().hasOnly(['x', 'z', 'yaw', 'cars', 'street', 'at'])
        && wd().x is number && wd().x >= -1300 && wd().x <= 400 && wd().z is number && wd().z >= -80 && wd().z <= 3470 && wd().yaw is number
        && (!('cars' in wd()) || (wd().cars is list && wd().cars.size() <= 3 && (wd().cars.size() < 1 || carOk(wd().cars[0])) && (wd().cars.size() < 2 || carOk(wd().cars[1])) && (wd().cars.size() < 3 || carOk(wd().cars[2]))))
        && (!('street' in wd()) || wd().street == null || carOk(wd().street))
        && wd().at == request.time && (resource == null || resource.data.at + duration.value(5, 's') < request.time);
    }
    // ================= Pal Park presence: rooms of ~20, ~4 writes/s while moving, stale docs removable by anyone
    match /parkRooms/{room}/p/{uid} {
      function pp() { return request.resource.data; }
      function cellNo() { return int(math.floor((float(pp().x - 1600) / 16.0 - 400.0) / 20.0)) + 6 * int(math.floor((float(pp().y - 1200) / 16.0 + 70.0) / 20.0)) + 1; } // js/world/layout.js ROOMS (20 m cells, 6 per row)
      function inNum() { return int(pp().in.replace('[hm]', '')); }
      // interior strip (house i -> cell i % 180, js/world/layout.js roomOf) or the mansion cells (40 m, 3 per row, y >= 10160)
      function mCell() { return int(math.floor((float(pp().x - 1600) / 16.0 - 400.0) / 40.0)) + 3 * int(math.floor((float(pp().y - 1200) / 16.0 - 560.0) / 40.0)); }
      function inCellOk() { return pp().y < 10160 ? cellNo() == (pp().in.size() == 6 ? inNum() : inNum() - 1) % 180 + 1 : (mCell() >= 0 && mCell() < 7 && pp().in == ['h483', 'h484', 'h485', 'h486', 'h487', 'h488', 'h489'][mCell()]); }
      function hp(id) { return /databases/$(database)/documents/homes/$(id); }
      function homeOk(id) { return id == 'h489' || !exists(hp(id)) || get(hp(id)).data.owner == me() || get(hp(id)).data.get('open', false) == true || me() in get(hp(id)).data.get('inv', []); }
      allow read: if signedIn();
      allow create, update: if signedIn() && notBanned() && uid == me() && room.matches('^r[0-9]{1,2}$')
        && pp().keys().hasOnly(['x', 'y', 'd', 'e', 'eAt', 'say', 'sayAt', 'tgt', 'name', 'uname', 'color', 'pal', 'at', 'h', 'r', 'dn', 'v', 'in', 'c', 'vx', 'vz', 'ct', 'an'])
        && (!('vx' in pp()) || (pp().vx is int && pp().vz is int && pp().vx >= -600 && pp().vx <= 600 && pp().vz >= -600 && pp().vz <= 600 && pp().ct is int && pp().an in ['idle', 'walk', 'run', 'drive', 'sit']))
        && (!('c' in pp()) || (pp().c is string && pp().c.matches('^-?[0-9]{1,3}_-?[0-9]{1,3}$')))
        // inside a house (interior strip x >= 8000): 'in' must be that cell's house and I need access (owner, open house, invited, or an unowned/NPC house)
        && (!('in' in pp()) || isStr(pp().in, 3, 6)) && (pp().x < 8000 || ('in' in pp() && pp().in.matches('^h[0-9]{2,3}$|^hm[0-9]{4}$') && inCellOk() && homeOk(pp().in)))
        // 3D park extras: height (dm), facing (deg), dance id, client version
        && (!('h' in pp()) || (pp().h is int && pp().h >= 0 && pp().h <= 2000))
        && (!('r' in pp()) || (pp().r is int && pp().r >= 0 && pp().r < 360))
        && (!('dn' in pp()) || isStr(pp().dn, 0, 20)) && (!('v' in pp()) || (pp().v is int && pp().v >= 0 && pp().v <= 99))
        // chat: a new message needs a fresh sayAt at least 2 s after the previous one (rate limit), max 60 chars (below)
        && (resource == null || !('say' in pp()) || pp().say == resource.data.get('say', '') || pp().sayAt is int && pp().sayAt >= resource.data.get('sayAt', 0) + 2000)
        && pp().x is int && pp().x >= -21000 && pp().x <= 10000 && pp().y is int && pp().y >= 0 && pp().y <= 60000
        && pp().d in [-1, 1] && isStr(pp().e, 0, 12) && isStr(pp().say, 0, 60) && isStr(pp().tgt, 0, 128)
        && pp().name == get(/databases/$(database)/documents/users/$(uid)).data.displayName
        && pp().uname == get(/databases/$(database)/documents/users/$(uid)).data.username
        // Parental Controls: chat off means no new 'say' text (same profile doc as above, no extra lookup)
        && (pp().say == '' || (resource != null && pp().say == resource.data.get('say', '')) || !pcOff(get(/databases/$(database)/documents/users/$(uid)).data, 'chat'))
        && pp().pal is map && pp().at == request.time
        && (resource == null || resource.data.at + duration.value(200, 'ms') < request.time);
      allow delete: if signedIn() && (uid == me() || resource.data.at < request.time - duration.value(2, 'm'));
    }
  }
}
